# Environment for a production (Coolify) deployment of Hoojah. Added in Slice 10b.
#
# This file is a TEMPLATE — copy the values into Coolify's environment editor. The app
# does not read a .env file in production; there is no dotenv gem in the Gemfile. It is
# checked in deliberately, so the required set is reviewable in git rather than living
# only in one person's browser tab.
#
# NEVER commit a filled-in copy. .dockerignore excludes .env and .env.* (but not this
# file) so a local copy cannot reach the image either.

# ===========================================================================
# REQUIRED — the app will not work correctly without every one of these
# ===========================================================================

# Baked into the Docker image already; listed for completeness and because anything
# other than "production" here is a serious misconfiguration, not a preference.
RAILS_ENV=production

# Decrypts config/credentials.yml.enc.
#
# ⚠️  READ THIS BEFORE THE FIRST DEPLOY. config/master.key DOES NOT EXIST in this repo
# or on any developer machine — it is gitignored and was never recovered from the
# original Rails 6 app. credentials.yml.enc is committed and is useless without it.
# So this value must be either RECOVERED (from wherever the original app was hosted) or
# REGENERATED, and regenerating means the existing credentials.yml.enc is discarded and
# rewritten with whatever secrets are still needed. That is an owner decision and an
# owner action; no code change can substitute for it.
#
# Note what does NOT depend on it: `secret_key_base` is not read from credentials in
# production if SECRET_KEY_BASE is set, and the Docker build uses SECRET_KEY_BASE_DUMMY,
# so the image builds without this key. Only runtime credential reads need it.
RAILS_MASTER_KEY=

# The single Postgres connection string. Slice 10b collapsed Solid Cache, Solid Queue and
# Solid Cable onto this same database (see config/database.yml), so this is the only
# database URL the app needs — there is no CACHE_DATABASE_URL / QUEUE_DATABASE_URL /
# CABLE_DATABASE_URL to set.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# The public hostname. Feeds `config.hosts <<` in config/environments/production.rb.
# Get this wrong and EVERY request is answered 403 — except /up, which is deliberately
# excluded so the platform health probe (which arrives on the container's internal
# address) still succeeds.
APP_HOST=hoojah.rudzainy.com

# ===========================================================================
# OPTIONAL — sensible defaults are baked into the Docker image
# ===========================================================================

# Already set to "true" in the Dockerfile. Sends Rails logs to stdout so Coolify's log
# viewer can see them, instead of to log/production.log inside the container.
# RAILS_LOG_TO_STDOUT=true

# Already set to "true" in the Dockerfile. Lets this process serve /assets. Turning it
# OFF means every stylesheet 404s and the app renders unstyled — only do that if
# something else in front of the container has the files.
# RAILS_SERVE_STATIC_FILES=true

# Defaults to "info". "debug" is noisy and logs request parameters.
# RAILS_LOG_LEVEL=info

# The port the container listens on. Coolify usually injects PORT; bin/docker-entrypoint
# maps it to Thruster's HTTP_PORT. Set HTTP_PORT directly to override. Puma itself runs
# on TARGET_PORT (3001) behind Thruster and is not reachable from outside the container.
# PORT=3000

# Puma thread pool, also the Active Record connection pool size (config/database.yml).
# RAILS_MAX_THREADS=5

# Solid Queue worker processes, read by config/queue.yml. Only meaningful in the worker
# service, not the web service.
# JOB_CONCURRENCY=1

# Full scheme+host the browser sees, for WebAuthn/passkey login (config/initializers/
# webauthn.rb). Dev and test fall back to http://localhost:3000. In production this MUST
# be the public origin or every passkey assertion fails the origin check.
# WEBAUTHN_ORIGIN=https://hoojah.rudzainy.com
