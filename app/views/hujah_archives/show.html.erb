<%# Read-only frozen snapshot of a tightened hoojah (Slice 2). Renders entirely from
    @archive.snapshot (jsonb) — no live records, no actions. The faithful record of what
    the purged viewer participated in, incl. their own vote and arguments. The per-stance
    breakdown is gated by the same k-anonymity threshold as live surfaces
    (Hujah::VOTE_BREAKDOWN_MIN): below it, only the total is shown, so a lone co-voter's
    stance can't be deduced. %>
<% snap = @archive.snapshot %>
<% agree = snap["agree_count"].to_i; neutral = snap["neutral_count"].to_i; disagree = snap["disagree_count"].to_i %>
<% total = agree + neutral + disagree %>
<div class="max-w-xl mx-auto p-4">
  <div class="mb-3 text-xs text-ink-2 uppercase tracking-wide">Archived · read-only</div>
  <%= render layout: "ui/card", locals: {padded: true} do %>
    <div class="text-sm text-ink-2 mb-1">@<%= snap["author"] %></div>
    <p class="text-ink whitespace-pre-line"><%= snap["body"] %></p>
    <div class="mt-3 text-sm text-ink-2">
      <% if total >= Hujah::VOTE_BREAKDOWN_MIN %>
        <%= snap.dig("stance_labels", "agree") %>: <%= agree %> ·
        <%= snap.dig("stance_labels", "neutral") %>: <%= neutral %> ·
        <%= snap.dig("stance_labels", "disagree") %>: <%= disagree %>
      <% else %>
        <%= pluralize(total, "vote") %>
      <% end %>
    </div>
  <% end %>

  <% if snap["arguments"].present? %>
    <h2 class="mt-6 mb-2 text-sm font-semibold text-ink">Arguments</h2>
    <%= render "hujah_archives/argument_tree", args: snap["arguments"] %>
  <% end %>
</div>
