<%# Debate transcript screen. Read-only once concluded; the composer renders only for
    the current_turn_user. Access is gated by DebatePolicy#show? in the controller
    (concluded → anyone incl. logged-out; active → participants only). %>
<%= render "shared/navbar" %>

<main class="max-w-xl mx-auto px-4 py-6">
  <%# Transcript + status ride the debate stream (viewer-agnostic); this viewer's
      composer + actions ride the user-signed stream (participants only). Both flow
      over the authorized DebateChannel (Task 3.1). %>
  <%= turbo_stream_from @debate, channel: "DebateChannel" %>
  <%= turbo_stream_from [@debate, current_user], channel: "DebateChannel" if @debate.participant?(current_user) %>

  <nav class="mb-2">
    <%= link_to hujah_path(@debate.hujah.slug), class: "text-primary no-underline", aria: {label: "Back"} do %>
      <%= lucide_icon("arrow-left", class: "w-6 h-6") %>
    <% end %>
  </nav>

  <header class="mb-2">
    <h1 class="flex items-center gap-2 text-xl leading-snug">
      <%= lucide_icon("swords", class: "w-5 h-5 shrink-0") %>
      @<%= @debate.challenger.username %> vs @<%= @debate.opponent.username %>
    </h1>
    <p class="text-sm text-grey truncate">
      On “<%= strip_tags(@debate.hujah.body) %>”
    </p>
  </header>

  <%# The status header card. `ui/_card` with `padded:` — its `px-4 py-3` is exactly
      what this row spelled by hand — and the flex layout in `class:`, which is a
      different utility family from the padding so it cannot collide with the flag.
      The two children are the pinned broadcast regions and stay siblings: `:status` is
      viewer-agnostic and rides the debate stream, `:actions` is viewer-scoped and rides
      this viewer's user-signed stream, so `viewer:` is passed EXPLICITLY here.

      PENDING gets its own dedicated accept/decline screen instead (Phase 3.3,
      `debates/_debate_pending`) — it composes these same two partials at the same
      pinned dom_ids, so the branch below still holds for every other status. %>
  <% if @debate.pending? %>
    <%= render "debates/debate_pending", debate: @debate, viewer: current_user %>
  <% else %>
    <%= render layout: "ui/card", locals: {padded: true, class: "flex items-center justify-between gap-2"} do %>
      <%= render "debates/debate_status", debate: @debate %>
      <%= render "debates/debate_actions", debate: @debate, viewer: current_user %>
    <% end %>
  <% end %>

  <%= render "debates/debate_transcript", debate: @debate, turns: @turns %>

  <%= render "debates/turn_composer", debate: @debate, viewer: current_user %>

  <% if @debate.concluded? %>
    <%= render "debates/verdict", debate: @debate %>
  <% end %>
</main>
