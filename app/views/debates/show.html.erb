<%# Debate transcript screen. Read-only once concluded; the composer renders only for
    the current_turn_user. Access is gated by DebatePolicy#show? in the controller
    (concluded → anyone incl. logged-out; active → participants only). %>
<%= render "shared/navbar" %>

<main class="max-w-xl mx-auto px-4 py-6">
  <nav class="mb-2">
    <%= link_to hujah_path(@debate.hujah.slug), class: "fill-primary text-primary no-underline", aria: {label: "Back"} do %>
      <%= lucide_icon("arrow-left", class: "w-6 h-6") %>
    <% end %>
  </nav>

  <header class="mb-2">
    <h1 class="flex items-center gap-2 text-xl leading-snug fill-neutral">
      <%= lucide_icon("swords", class: "w-5 h-5 shrink-0") %>
      @<%= @debate.challenger.username %> vs @<%= @debate.opponent.username %>
    </h1>
    <p class="text-sm text-grey truncate">
      On “<%= strip_tags(@debate.hujah.body) %>”
    </p>
  </header>

  <%= render "debates/debate_status", debate: @debate %>

  <%= render "debates/debate_transcript", debate: @debate, turns: @turns %>

  <%= render "debates/turn_composer", debate: @debate %>
</main>
