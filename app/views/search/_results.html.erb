<%# The `#search-results` turbo-frame body — re-rendered by `SearchController#index`
    on every GET, so this is the ONE place "what search results look like" is decided,
    whether the request is the initial page load, a JS-off form submit, or a
    Stimulus-driven live-suggest refetch (search_controller.js).

    `@query` blank → only the trending/browse hashtag area (there is nothing to
    match). `@query` present → "Top matches" first (hashtags, then hoojahs, then
    people — each already ≤8 and visibility-safe, per `SearchController#index`), THEN
    the SAME trending/browse area below it: the mockup keeps the hashtag cloud on
    screen even mid-search, so a query never hides it. %>
<% if @query.present? %>
  <% results = [@hashtags, @hujahs, @users] %>
  <% if results.any?(&:present?) %>
    <div class="text-xs font-bold uppercase tracking-wide text-faint mt-1 mb-2">
      Top matches for &ldquo;<%= @query %>&rdquo;
    </div>
    <div class="flex flex-col gap-2 mb-2">
      <%= render partial: "search/result_hashtag", collection: @hashtags, as: :hashtag %>
      <%= render partial: "search/result_hujah", collection: @hujahs, as: :hujah %>
      <%= render partial: "search/result_user", collection: @users, as: :user %>
    </div>
  <% else %>
    <%= render "ui/empty_state", message: "No results for “#{@query}”", icon: "search" %>
  <% end %>
  <%= render "ui/divider", class: "my-2" %>
<% end %>

<% browse_hashtags = @browse_hashtags.to_a %>
<% if browse_hashtags.any? %>
  <div class="text-xs font-bold uppercase tracking-wide text-faint mt-1 mb-2">Trending hashtags</div>
  <%= render "search/hashtag_chips", hashtags: browse_hashtags.first(8) %>

  <div class="text-xs font-bold uppercase tracking-wide text-faint mt-4 mb-2">Browse hashtags</div>
  <%= render "search/hashtag_chips", hashtags: browse_hashtags %>
<% else %>
  <%= render "ui/empty_state", message: "No hashtags yet", icon: "hash" %>
<% end %>
