<div class="max-w-md mx-auto mt-16 p-6 bg-white rounded shadow">
  <h2 class="text-2xl font-semibold mb-6">Log in</h2>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <div class="mb-3">
      <%= f.label :email, class: "block text-sm" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full border rounded px-3 py-2" %>
    </div>

    <div class="mb-3">
      <%= f.label :password, class: "block text-sm" %>
      <%= f.password_field :password, autocomplete: "current-password", class: "w-full border rounded px-3 py-2" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="mb-3 flex items-center gap-2">
        <%= f.check_box :remember_me %>
        <%= f.label :remember_me, class: "text-sm" %>
      </div>
    <% end %>

    <div class="mt-4">
      <%= f.submit "Log in", class: "bg-primary text-white rounded px-4 py-2" %>
    </div>
  <% end %>

  <div class="mt-4 text-sm">
    <%= render "devise/shared/links" %>
  </div>
</div>
