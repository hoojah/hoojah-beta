<%# The log-in screen. POSTs to Devise's own session path; nothing about the form
    element, its verb or its field names may move — Warden authenticates on
    `user[email]` / `user[password]` / `user[remember_me]` by exactly those names.

    HOOJAH 2026 (Phase 1.1) — restyled from the Card.jsx-borrowed treatment (Slice
    9, Task 4.6) to the 2026 mockup's "Auth · sign in" frame: no white card
    panel — the page itself carries `bg-surface`, each field
    is a 52px `bg-card-2` row with a leading Lucide icon, and the password field's
    trailing control is the new `password_visibility` Stimulus controller (a tiny,
    JS-off-safe reveal toggle — with JS disabled it's a perfectly ordinary
    `type="password"` field and the toggle button does nothing).

    No error summary here on purpose: Devise answers a bad login with a flash, not
    with `resource.errors`, so `devise/shared/_error_messages` would never have
    anything to say on this screen (unchanged from the pre-2026 note).

    "Continue with Google" is WIRED (Track B) — a `button_to` POST to Devise's
    `google_oauth2` OmniAuth request phase (`user_google_oauth2_omniauth_authorize_path`,
    i.e. POST /auth/google_oauth2). Turbo is disabled on this form (`data: { turbo: false }`)
    so the request-phase 302 to Google is a real full-page navigation, not a Turbo fetch.
    The POST verb matters: OmniAuth 2 only accepts POST on its request path (CVE-2015-9284),
    and `omniauth-rails_csrf_protection` verifies the CSRF token `button_to` carries.
%>
<div class="min-h-screen bg-surface flex items-center justify-center px-6 py-12">
  <div class="w-full max-w-sm">
    <%= render "devise/shared/brand" %>

    <h1 class="mt-6 text-2xl font-extrabold leading-tight text-ink">Where Malaysia's brilliant minds debate.</h1>
    <p class="mt-2 text-sm text-ink-2 leading-relaxed">Post a hoojah. Gather votes. Settle it in a debate.</p>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="mt-6 flex flex-col gap-3">
        <div class="flex items-center gap-3 h-[52px] px-4 rounded-xl bg-card-2 border border-field">
          <%= lucide_icon "mail", class: "w-[19px] h-[19px] text-faint shrink-0" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "Email address",
                class: "flex-1 min-w-0 bg-transparent border-0 outline-none text-[14.5px] text-ink placeholder:text-faint" %>
        </div>

        <div class="flex items-center gap-3 h-[52px] px-4 rounded-xl bg-card-2 border border-field" data-controller="password-visibility">
          <%= lucide_icon "lock", class: "w-[19px] h-[19px] text-faint shrink-0" %>
          <%= f.password_field :password, autocomplete: "current-password", placeholder: "Password",
                data: {password_visibility_target: "field"},
                class: "flex-1 min-w-0 bg-transparent border-0 outline-none text-[14.5px] text-ink placeholder:text-faint" %>
          <button type="button" data-action="password-visibility#toggle" aria-label="Show password" class="shrink-0 text-faint">
            <%= lucide_icon "eye", class: "w-[19px] h-[19px]", data: {password_visibility_target: "showIcon"} %>
            <%= lucide_icon "eye-off", class: "w-[19px] h-[19px]", data: {password_visibility_target: "hideIcon"}, hidden: true %>
          </button>
        </div>
      </div>

      <%= f.submit "Log in", class: "mt-4 w-full h-[52px] rounded-xl bg-primary text-white font-bold shadow cursor-pointer" %>

      <%= link_to "Forgot password?", new_password_path(resource_name), class: "block text-center mt-3 text-sm font-semibold text-primary" %>

      <% if devise_mapping.rememberable? %>
        <div class="mt-4 flex items-center gap-2">
          <%= f.check_box :remember_me, class: "w-4 h-4" %>
          <%= f.label :remember_me, class: "text-sm text-ink-2" %>
        </div>
      <% end %>
    <% end %>

    <div class="flex items-center gap-3 my-6">
      <div class="flex-1 h-px bg-hairline"></div>
      <span class="text-xs font-semibold text-faint">or</span>
      <div class="flex-1 h-px bg-hairline"></div>
    </div>

    <%= button_to user_google_oauth2_omniauth_authorize_path,
          method: :post,
          form: {data: {turbo: false}},
          class: "w-full h-[52px] rounded-xl border border-field bg-card text-ink font-bold text-[14.5px] flex items-center justify-center gap-2.5" do %>
      <svg width="19" height="19" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
      Continue with Google
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>
