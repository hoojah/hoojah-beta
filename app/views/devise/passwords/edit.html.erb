<div class="max-w-md mx-auto mt-16 p-6 bg-white rounded shadow">
  <h2 class="text-2xl font-semibold mb-6">Change your password</h2>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>

    <div class="mb-3">
      <%= f.label :password, "New password", class: "block text-sm" %>
      <% if @minimum_password_length %>
        <em class="text-xs text-gray-500">(<%= @minimum_password_length %> characters minimum)</em>
      <% end %>
      <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "w-full border rounded px-3 py-2" %>
    </div>

    <div class="mb-3">
      <%= f.label :password_confirmation, "Confirm new password", class: "block text-sm" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full border rounded px-3 py-2" %>
    </div>

    <div class="mt-4">
      <%= f.submit "Change my password", class: "bg-primary text-white rounded px-4 py-2" %>
    </div>
  <% end %>

  <div class="mt-4 text-sm">
    <%= render "devise/shared/links" %>
  </div>
</div>
