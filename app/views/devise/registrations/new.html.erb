<%# The sign-up screen. POSTs to Devise's registration path with `user[full_name]`,
    `user[username]`, `user[email]`, `user[password]`, `user[password_confirmation]` —
    all frozen, all sanitised by `Users::RegistrationsController`.

    SECURITY: `invisible_captcha :subtitle` (Slice 1) is a spam control, not markup.
    It emits its own wrapper and its own hidden field, and the controller rejects a
    create whose honeypot came back filled. Do not restyle it, do not move it inside a
    field group, and do not touch how it hides itself — the hiding IS the control.

    HOOJAH 2026 (Phase 1.1) — same restyle as the log-in screen: no white card
    panel, `bg-surface` page, 52px `bg-card-2` field rows with leading Lucide
    icons, and a `password_visibility` reveal toggle on BOTH password fields.
    Each field row carries its own `data-controller="password-visibility"`, so
    the two toggles are independent Stimulus instances — clicking one never
    affects the other's field/icons.

    The password-length hint moves from a Tailwind-default grey onto the design
    system's `text-faint` token, same as the pre-2026 version did onto its own
    muted token — the palette still has no grey between those two.

    "Continue with Google" (Track B) mirrors the log-in screen: an "or" divider then a
    `button_to` POST to `user_google_oauth2_omniauth_authorize_path` (POST /auth/google_oauth2)
    with Turbo disabled so the OmniAuth request-phase redirect to Google is a full navigation.
    Now that the button is WIRED (real OmniAuth sign-up with email auto-linking), the second
    entry point is a genuine account path, not the unwired decoy the earlier note warned off.
%>
<div class="min-h-screen bg-surface flex items-center justify-center px-6 py-12">
  <div class="w-full max-w-sm">
    <%= render "devise/shared/brand" %>

    <h1 class="mt-6 text-2xl font-extrabold leading-tight text-ink">Join the debate.</h1>
    <p class="mt-2 text-sm text-ink-2 leading-relaxed">Create an account to post a hoojah and cast your vote.</p>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <%= invisible_captcha :subtitle %>

      <div class="mt-6 flex flex-col gap-3">
        <div class="flex items-center gap-3 h-[52px] px-4 rounded-xl bg-card-2 border border-field">
          <%= lucide_icon "user", class: "w-[19px] h-[19px] text-faint shrink-0" %>
          <%= f.text_field :full_name, autofocus: true, placeholder: "Full name",
                class: "flex-1 min-w-0 bg-transparent border-0 outline-none text-[14.5px] text-ink placeholder:text-faint" %>
        </div>

        <div class="flex items-center gap-3 h-[52px] px-4 rounded-xl bg-card-2 border border-field">
          <%= lucide_icon "at-sign", class: "w-[19px] h-[19px] text-faint shrink-0" %>
          <%= f.text_field :username, placeholder: "Username",
                class: "flex-1 min-w-0 bg-transparent border-0 outline-none text-[14.5px] text-ink placeholder:text-faint" %>
        </div>

        <div class="flex items-center gap-3 h-[52px] px-4 rounded-xl bg-card-2 border border-field">
          <%= lucide_icon "mail", class: "w-[19px] h-[19px] text-faint shrink-0" %>
          <%= f.email_field :email, autocomplete: "email", placeholder: "Email address",
                class: "flex-1 min-w-0 bg-transparent border-0 outline-none text-[14.5px] text-ink placeholder:text-faint" %>
        </div>

        <div>
          <div class="flex items-center gap-3 h-[52px] px-4 rounded-xl bg-card-2 border border-field" data-controller="password-visibility">
            <%= lucide_icon "lock", class: "w-[19px] h-[19px] text-faint shrink-0" %>
            <%= f.password_field :password, autocomplete: "new-password", placeholder: "Password",
                  data: {password_visibility_target: "field"},
                  class: "flex-1 min-w-0 bg-transparent border-0 outline-none text-[14.5px] text-ink placeholder:text-faint" %>
            <button type="button" data-action="password-visibility#toggle" aria-label="Show password" class="shrink-0 text-faint">
              <%= lucide_icon "eye", class: "w-[19px] h-[19px]", data: {password_visibility_target: "showIcon"} %>
              <%= lucide_icon "eye-off", class: "w-[19px] h-[19px]", data: {password_visibility_target: "hideIcon"}, hidden: true %>
            </button>
          </div>
          <% if @minimum_password_length %>
            <p class="mt-1.5 ml-1 text-xs text-faint"><%= @minimum_password_length %> characters minimum</p>
          <% end %>
        </div>

        <div class="flex items-center gap-3 h-[52px] px-4 rounded-xl bg-card-2 border border-field" data-controller="password-visibility">
          <%= lucide_icon "lock", class: "w-[19px] h-[19px] text-faint shrink-0" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "Confirm password",
                data: {password_visibility_target: "field"},
                class: "flex-1 min-w-0 bg-transparent border-0 outline-none text-[14.5px] text-ink placeholder:text-faint" %>
          <button type="button" data-action="password-visibility#toggle" aria-label="Show password" class="shrink-0 text-faint">
            <%= lucide_icon "eye", class: "w-[19px] h-[19px]", data: {password_visibility_target: "showIcon"} %>
            <%= lucide_icon "eye-off", class: "w-[19px] h-[19px]", data: {password_visibility_target: "hideIcon"}, hidden: true %>
          </button>
        </div>
      </div>

      <%= f.submit "Sign up", class: "mt-4 w-full h-[52px] rounded-xl bg-primary text-white font-bold shadow cursor-pointer" %>
    <% end %>

    <div class="flex items-center gap-3 my-6">
      <div class="flex-1 h-px bg-hairline"></div>
      <span class="text-xs font-semibold text-faint">or</span>
      <div class="flex-1 h-px bg-hairline"></div>
    </div>

    <%= button_to user_google_oauth2_omniauth_authorize_path,
          method: :post,
          form: {data: {turbo: false}},
          class: "w-full h-[52px] rounded-xl border border-field bg-card text-ink font-bold text-[14.5px] flex items-center justify-center gap-2.5" do %>
      <svg width="19" height="19" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
      Continue with Google
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>
