<%# Plain, inline-styled email body (mail clients ignore <style>/external CSS, and
    this ERB is Tailwind-scanned — so NO utility class names here). @link is the
    deep link; the heading reuses the mailer subject. %>
<div style="font-family: -apple-system, system-ui, sans-serif; color: #1c1c28; line-height: 1.5;">
  <p style="margin: 0 0 16px 0; font-size: 16px;"><%= @heading %></p>

  <p style="margin: 0 0 24px 0;">
    <a href="<%= @link %>" style="color: #415de6; text-decoration: underline;">View it on Hoojah</a>
  </p>

  <p style="margin: 0; font-size: 12px; color: #6b7280;">
    You are receiving this because you have email notifications turned on. You can
    turn them off any time from your profile settings on Hoojah.
  </p>
</div>
