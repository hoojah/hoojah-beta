<%# Faithful port of the legacy SPA `Layouts/navbar.js`:
    - brand → root
    - logged out: "Login" link (+ signup)
    - logged in: avatar menu (@handle, profile, notifications w/ unread indicator,
      "Log Out" via button_to DELETE /logout)
    - "New Claim" compose entry (compose form itself lands in Slice 2). %>
<nav class="fixed top-0 inset-x-0 z-20 bg-white/90 backdrop-blur border-b border-gray-100">
  <div class="max-w-xl mx-auto px-4 h-14 flex items-center justify-between">
    <%= link_to root_path, class: "font-bold text-primary text-xl no-underline" do %>Hoojah<% end %>

    <div class="flex items-center gap-3">
      <%= link_to trending_path, class: "flex items-center text-grey hover:text-primary no-underline", aria: {label: "Trending"} do %>
        <%= lucide_icon("flame", class: "w-6 h-6") %>
        <span class="hidden lg:inline ml-1">Trending</span>
      <% end %>

      <% if user_signed_in? %>
        <details class="relative">
          <summary class="list-none cursor-pointer flex items-center">
            <%= image_tag current_user.photo, class: "rounded-full w-9 h-9", alt: current_user.username %>
            <% if current_user.unread_notifications_count > 0 %>
              <span class="ml-1 inline-block w-2 h-2 rounded-full bg-neutral" aria-label="Unread notifications"></span>
            <% end %>
          </summary>
          <div class="absolute right-0 mt-1 w-56 bg-white shadow rounded p-2 z-10">
            <h6 class="text-xs text-grey px-3 pb-1">@<%= current_user.username %></h6>
            <%= link_to "Your profile", "#", class: "block px-3 py-1 text-black no-underline hover:bg-gray-100 rounded" %>
            <%= link_to "Dashboard", dashboard_path, class: "block px-3 py-1 text-black no-underline hover:bg-gray-100 rounded" %>
            <%= link_to notifications_path, class: "block px-3 py-1 text-black no-underline hover:bg-gray-100 rounded" do %>
              Your notifications
              <% if current_user.unread_notifications_count > 0 %>
                <span class="ml-1 inline-block w-2 h-2 rounded-full bg-neutral align-middle"></span>
              <% end %>
            <% end %>
            <div class="border-t border-gray-100 my-1"></div>
            <%= button_to "Log Out", destroy_user_session_path, method: :delete,
                  class: "block w-full text-left px-3 py-1 text-black hover:bg-gray-100 rounded" %>
          </div>
        </details>
      <% else %>
        <%= link_to "Login", new_user_session_path, class: "text-primary no-underline" %>
        <%= link_to "Sign up", new_user_registration_path, class: "text-grey no-underline" %>
      <% end %>

      <%= link_to new_hujah_path, class: "flex items-center fill-primary text-primary no-underline", aria: { label: "New Claim" } do %>
        <%= lucide_icon("message-square-plus", class: "w-6 h-6") %>
        <span class="hidden lg:inline ml-1">New Claim</span>
      <% end %>
    </div>
  </div>
</nav>
<div class="h-14"></div>
