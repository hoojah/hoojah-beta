<%# Faithful port of the legacy SPA `Layouts/navbar.js`:
    - brand → root
    - logged out: "Login" link (+ signup)
    - logged in: avatar menu (@handle, profile, notifications w/ unread indicator,
      "Log Out" via button_to DELETE /logout)
    - "New Claim" compose entry (compose form itself lands in Slice 2).

    Fixed, 56px, `bg-white/90 backdrop-blur` over a hairline — this bar is the ONLY blur
    in the product (docs/design-system/readme.md, VISUAL FOUNDATIONS). Its icons are 24px;
    16px is for inline icons elsewhere.

    The three icon links below are deliberately NOT `ds_button_classes`. That helper emits
    the house *button* — a pill, or the `link` variant used by the bare text controls in a
    notification row — and both carry `active:scale-95`, which the design system assigns to
    vote buttons, not to chrome. Navbar entries are icon links; the DS gives them no button
    treatment, so they stay anchors. %>
<nav class="fixed top-0 inset-x-0 z-20 bg-white/90 backdrop-blur border-b border-gray-100">
  <div class="max-w-xl mx-auto px-4 h-14 flex items-center justify-between">
    <%= link_to root_path, class: "flex items-center no-underline", aria: { label: "Hoojah" } do %>
      <%= image_tag "logo.svg", alt: "Hoojah", class: "h-7 w-auto" %>
    <% end %>

    <div class="flex items-center gap-3">
      <%= link_to trending_path, class: "flex items-center text-grey hover:text-primary no-underline", aria: {label: "Trending"} do %>
        <%= lucide_icon("flame", class: "w-6 h-6") %>
        <span class="hidden lg:inline ml-1">Trending</span>
      <% end %>

      <% if user_signed_in? %>
        <%# `<details>` IS the menu mechanism here — the design system documents it as such
            (components/navigation/DropdownMenu.prompt.md). No Stimulus controller, and it
            closes on an outside click for free. Do not "upgrade" it to JS. %>
        <details class="relative">
          <summary class="list-none cursor-pointer flex items-center">
            <%# 36px, the design system's `nav` avatar box. Via the partial rather than
                `image_tag current_user.photo`, which raises on a user whose photo is
                blank — reachable, since `:photo` is permitted in `user_params` and
                `assign_random_photo` only backfills on create. That would 500 the
                navbar, i.e. every signed-in page at once. %>
            <%= render "ui/avatar", user: current_user, size: :nav %>
            <% if current_user.unread_notifications_count > 0 %>
              <%# 8px pink dot, never a count badge — the design system is explicit. %>
              <span class="ml-1 inline-block w-2 h-2 rounded-full bg-neutral" aria-label="Unread notifications"></span>
            <% end %>
          </summary>
          <%# The house `MenuItem` row, shared by all three of the product's dropdowns.
              Spelled once here so the Log Out button cannot drift from the links above
              it — it is the one row that is not an `<a>`, and it looked different by a
              `no-underline` before this. %>
          <% menu_row = "block px-3 py-1 text-black no-underline hover:bg-gray-100 rounded" %>
          <div class="absolute right-0 mt-1 w-56 bg-white shadow rounded p-2 z-10">
            <h6 class="text-xs text-grey px-3 pb-1">@<%= current_user.username %></h6>
            <%= link_to "Your profile", profile_path(current_user.username), class: menu_row %>
            <%= link_to "Dashboard", dashboard_path, class: menu_row %>
            <%= link_to notifications_path, class: menu_row do %>
              Your notifications
              <% if current_user.unread_notifications_count > 0 %>
                <span class="ml-1 inline-block w-2 h-2 rounded-full bg-neutral align-middle"></span>
              <% end %>
            <% end %>
            <%= render "ui/divider", class: "my-1" %>
            <%= button_to "Log Out", destroy_user_session_path, method: :delete,
                  class: "#{menu_row} w-full text-left" %>
          </div>
        </details>
      <% else %>
        <%= link_to "Login", new_user_session_path, class: "text-primary no-underline" %>
        <%= link_to "Sign up", new_user_registration_path, class: "text-grey no-underline" %>
      <% end %>

      <%= link_to new_hujah_path, class: "flex items-center fill-primary text-primary no-underline", aria: { label: "New Claim" } do %>
        <%= lucide_icon("message-square-plus", class: "w-6 h-6") %>
        <span class="hidden lg:inline ml-1">New Claim</span>
      <% end %>
    </div>
  </div>
</nav>
<div class="h-14"></div>
