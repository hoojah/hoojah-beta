<%# Interstitial after a MyDigital ID sign-in whose subject can't be signed in
    automatically. Branches (design system: ds_* helpers, token colours, no hex).
    SIGNED-IN state machine, in order:
      (c) sub linked to a DIFFERENT account → confirm SWITCH
      (b) sub linked to THIS account        → already linked to this MyDigital ID
      (a) current_user already has a MyID    → already linked (to a different MyID)
          otherwise                          → confirm LINK to the current account
    SIGNED-OUT: the anonymous link-or-create forms (unchanged). %>
<div class="min-h-screen flex items-center justify-center px-4 py-10">
  <div class="<%= ds_card_classes %> w-full max-w-md p-6 sm:p-8">
    <% if @signed_in && @switch_target && @switch_target != current_user %>
      <%# (c) The pending sub belongs to another account: confirm switching into it.
          Never an automatic switch — the callback routed here on purpose. %>
      <h1 class="text-xl font-bold text-ink">Switch accounts?</h1>
      <p class="mt-2 text-sm text-faint">
        This MyDigital ID is registered to
        <span class="font-semibold text-ink">@<%= @switch_target.username %></span>.
        You're signed in as
        <span class="font-semibold text-ink">@<%= current_user.username %></span>.
        Switch to @<%= @switch_target.username %>?
      </p>

      <%= button_to "Switch to @#{@switch_target.username}", mydigital_id_switch_path, method: :post,
            class: "#{ds_button_classes(tone: :primary)} w-full h-[52px] mt-6" %>
      <%= link_to "Stay signed in as @#{current_user.username}", root_path,
            class: "#{ds_button_classes(tone: :neutral)} w-full h-[52px] mt-2" %>

    <% elsif @signed_in && @switch_target == current_user %>
      <%# (b) The pending sub is already linked to THIS account. %>
      <h1 class="text-xl font-bold text-ink">Already linked</h1>
      <p class="mt-2 text-sm text-faint">
        Your account (<span class="font-semibold text-ink">@<%= current_user.username %></span>)
        is already linked to this MyDigital ID.
      </p>
      <%= link_to "Back to Hoojah", root_path,
            class: "#{ds_button_classes(tone: :primary)} w-full h-[52px] mt-6" %>

    <% elsif @signed_in && @already_linked %>
      <%# (a) Signed in, already linked to a (different) MyDigital ID: nothing to do. %>
      <h1 class="text-xl font-bold text-ink">Already linked</h1>
      <p class="mt-2 text-sm text-faint">
        Your account (<span class="font-semibold text-ink">@<%= current_user.username %></span>)
        is already linked to a MyDigital ID.
      </p>
      <%= link_to "Back to Hoojah", root_path,
            class: "#{ds_button_classes(tone: :primary)} w-full h-[52px] mt-6" %>

    <% elsif @signed_in %>
      <%# (a) Signed in, unlinked sub: confirm linking to the CURRENT account. L1 —
          never a silent new-account switch. %>
      <h1 class="text-xl font-bold text-ink">Link your MyDigital ID</h1>
      <p class="mt-2 text-sm text-faint">
        You're signed in as <span class="font-semibold text-ink">@<%= current_user.username %></span>.
        Link your MyDigital ID<% if @name.present? %>
        (<span class="font-semibold text-ink"><%= @name %></span>)<% end %>
        to this account?
      </p>

      <%= button_to "Link to this account", mydigital_id_link_current_path, method: :post,
            class: "#{ds_button_classes(tone: :primary)} w-full h-[52px] mt-6" %>

      <p class="mt-4 text-sm text-faint">
        This isn't the account I want?
      </p>
      <%= button_to "Log out", destroy_user_session_path, method: :delete,
            class: "#{ds_button_classes(tone: :neutral)} w-full h-[52px] mt-2" %>

    <% else %>
      <%# Signed out: the anonymous link-or-create paths. %>
      <h1 class="text-xl font-bold text-ink">Welcome via MyDigital ID</h1>
      <p class="mt-2 text-sm text-faint">
        We verified your MyDigital ID<% if @name.present? %>,
        <span class="font-semibold text-ink"><%= @name %></span><% end %>.
        Link it to your Hoojah account, or create a new one.
      </p>

      <%# Path 1: link an existing account %>
      <%= form_with url: mydigital_id_link_path, method: :post, class: "mt-6 space-y-3" do |f| %>
        <label class="block text-sm font-semibold text-ink">Link my existing Hoojah account</label>
        <%= f.email_field :email, placeholder: "you@example.com", autocomplete: "email",
              class: "w-full h-[52px] rounded-xl border border-field bg-card text-ink px-4" %>
        <%= f.password_field :password, placeholder: "Password", autocomplete: "current-password",
              class: "w-full h-[52px] rounded-xl border border-field bg-card text-ink px-4" %>
        <%= f.submit "Link and continue",
              class: "#{ds_button_classes(tone: :primary)} w-full h-[52px]" %>
      <% end %>

      <div class="flex items-center gap-3 my-6">
        <div class="flex-1 h-px bg-hairline"></div>
        <span class="text-xs font-semibold text-faint">or</span>
        <div class="flex-1 h-px bg-hairline"></div>
      </div>

      <%# Path 2: create a new account (username only) %>
      <%= form_with url: mydigital_id_register_path, method: :post, class: "space-y-3" do |f| %>
        <label class="block text-sm font-semibold text-ink">I don't have a Hoojah account yet</label>
        <%= f.text_field :username, placeholder: "Choose a username", autocomplete: "off",
              pattern: "[A-Za-z0-9_]+",
              class: "w-full h-[52px] rounded-xl border border-field bg-card text-ink px-4" %>
        <p class="text-xs text-faint">Letters, numbers, and underscores only.</p>
        <%= f.submit "Create account and continue",
              class: "#{ds_button_classes(tone: :neutral)} w-full h-[52px]" %>
      <% end %>
    <% end %>

    <p class="mt-6 text-xs text-faint">
      <%= link_to "How MyDigital ID login works", mydigital_id_info_path, class: "underline" %>
    </p>
  </div>
</div>
