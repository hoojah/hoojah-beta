<%# Unfollow succeeded: flip the button back to "Follow" and refresh the
    follower-count chip. Same two replaces as create — the partials re-derive their
    state from current_user + @target. %>
<%= turbo_stream.replace dom_id(@target, :follow_button) do %>
  <%= render "users/follow_button", user: @target %>
<% end %>
<%= turbo_stream.replace dom_id(@target, :follower_count) do %>
  <%= render "users/follower_count", user: @target %>
<% end %>
