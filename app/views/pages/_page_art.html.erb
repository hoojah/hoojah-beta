    <path stroke="var(--primary)" d="M148 42h20M148 52h26"></path>
    <circle cx="148" cy="63" r="3" fill="var(--agree)" stroke="none"></circle>
    <circle cx="160" cy="63" r="3" fill="var(--neutral)" stroke="none"></circle>
    <circle cx="172" cy="63" r="3" fill="var(--disagree)" stroke="none"></circle>
    <path stroke="var(--ink)" d="M70 72h180v10H70z"></path>
    <path stroke="var(--ink)" stroke-width="3" d="M134 77h52"></path>
    <path stroke="var(--ink)" d="M80 82h160v54a6 6 0 0 1-6 6H86a6 6 0 0 1-6-6z"></path>
    <path stroke="var(--ink)" d="M212 98l12-4 12 4v10c0 8-6 12-12 14-6-2-12-6-12-14z"></path>
    <path stroke="var(--agree)" stroke-width="2" d="M219 109l3 3 6-6"></path>
    <path stroke="var(--faint)" d="M30 44c8-8 22-8 30 0-8 8-22 8-30 0z"></path>
    <path stroke="var(--faint)" d="M32 54l26-20"></path>
  </svg>
<% when "terms" %>
  <svg viewBox="0 0 320 160" width="360" class="max-w-full h-auto block" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path stroke="var(--ink)" d="M98 18h94l32 32v90a6 6 0 0 1-6 6H98a6 6 0 0 1-6-6V24a6 6 0 0 1 6-6z"></path>
    <path stroke="var(--ink)" d="M192 18v32h32"></path>
    <path stroke="var(--faint)" d="M112 66h80M112 82h96M112 98h64"></path>
    <path stroke="var(--primary)" stroke-width="2" d="M112 128c6-12 12 2 20-6s8 10 16 0 6-4 12 0"></path>
    <circle cx="192" cy="124" r="14" stroke="var(--primary)"></circle>
    <path stroke="var(--primary)" stroke-width="2" d="M185 124l5 5 9-9"></path>
    <path stroke="var(--faint)" d="M40 120h28M54 120v20M44 140h20"></path>
    <path stroke="var(--faint)" d="M40 120l-8 12h16zM68 120l-8 12h16z"></path>
  </svg>
<% end %>
