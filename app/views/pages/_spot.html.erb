<%# Section-spot icon for About/Tutorials sections (56px rounded box wraps this in
    pages/_section). 40×40 inline SVG stroked with theme tokens. `spot` selects the glyph. %>
<% case spot %>
<% when "claim" %>
  <svg viewBox="0 0 48 48" width="40" height="40" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path stroke="var(--ink)" d="M10 8h28a6 6 0 0 1 6 6v16a6 6 0 0 1-6 6H24l-8 7v-7h-6a6 6 0 0 1-6-6V14a6 6 0 0 1 6-6z"></path><path stroke="var(--primary)" stroke-width="2" d="M24 15v9"></path><circle cx="24" cy="29.5" r="1.6" fill="var(--primary)"></circle></svg>
<% when "votes" %>
  <svg viewBox="0 0 48 48" width="40" height="40" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10" cy="24" r="7.5" stroke="var(--agree)"></circle><g transform="translate(5.8 19.8) scale(.35)" stroke="var(--agree)" stroke-width="4.3"><path d="M7 10v12"></path><path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2a3.13 3.13 0 0 1 3 3.88Z"></path></g><circle cx="24" cy="24" r="7.5" stroke="var(--neutral)"></circle><path stroke="var(--neutral)" d="M20.5 24h7"></path><circle cx="38" cy="24" r="7.5" stroke="var(--disagree)"></circle><g transform="translate(33.8 19.8) scale(.35)" stroke="var(--disagree)" stroke-width="4.3"><path d="M17 14V2"></path><path d="M9 18.12 10 14H4.17a2 2 0 0 1-1.92-2.56l2.33-8A2 2 0 0 1 6.5 2H20a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-2.76a2 2 0 0 0-1.79 1.11L12 22a3.13 3.13 0 0 1-3-3.88Z"></path></g></svg>
<% when "mission" %>
  <svg viewBox="0 0 48 48" width="40" height="40" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="24" cy="24" r="17" stroke="var(--ink)"></circle><circle cx="24" cy="24" r="9.5" stroke="var(--faint)"></circle><circle cx="24" cy="24" r="2.5" fill="var(--primary)"></circle><path stroke="var(--primary)" d="M24 24 39 9M33 9h6v6"></path></svg>
<% when "compose" %>
  <svg viewBox="0 0 48 48" width="40" height="40" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="10" width="28" height="28" rx="4" stroke="var(--ink)"></rect><path stroke="var(--faint)" d="M12 20h10M12 27h14"></path><path stroke="var(--primary)" fill="var(--primary-soft)" d="M39 7l5 5-15 15-7 2 2-7z"></path></svg>
<% when "responses" %>
  <svg viewBox="0 0 48 48" width="40" height="40" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path stroke="var(--ink)" d="M8 5h20a5 5 0 0 1 5 5v8a5 5 0 0 1-5 5H17l-6 5v-5H8a5 5 0 0 1-5-5v-8a5 5 0 0 1 5-5z"></path><path stroke="var(--faint)" d="M10 13h12M10 18h8"></path><path stroke="var(--primary)" d="M22 27h18a5 5 0 0 1 5 5v6a5 5 0 0 1-5 5h-2v4l-5-4H22a5 5 0 0 1-5-5v-6a5 5 0 0 1 5-5z"></path><circle cx="21" cy="27" r="2.6" fill="var(--agree)"></circle></svg>
<% when "debate" %>
  <svg viewBox="0 0 48 48" width="40" height="40" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><g transform="translate(6 6) scale(1.5)" stroke-width="1"><polyline stroke="var(--ink)" points="14.5 17.5 3 6 3 3 6 3 17.5 14.5"></polyline><line stroke="var(--ink)" x1="13" x2="19" y1="19" y2="13"></line><line stroke="var(--ink)" x1="16" x2="20" y1="16" y2="20"></line><line stroke="var(--ink)" x1="19" x2="21" y1="21" y2="19"></line><polyline stroke="var(--primary)" points="14.5 6.5 18 3 21 3 21 6 17.5 9.5"></polyline><line stroke="var(--primary)" x1="5" x2="9" y1="14" y2="18"></line><line stroke="var(--primary)" x1="7" x2="4" y1="17" y2="20"></line><line stroke="var(--primary)" x1="3" x2="5" y1="19" y2="21"></line></g></svg>
<% end %>
