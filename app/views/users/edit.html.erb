<%# No-JS / progressive-enhancement fallback for editing the profile. Renders the
    same header + edit modal as the show page, but with the dialog opened inline so
    the form is usable without Stimulus. The primary edit path is the modal on the
    profile page (dialog#open). Re-rendered on validation failure (422). %>
<%= render "shared/navbar" %>

<main class="max-w-xl mx-auto px-4 py-6">
  <div class="relative flex justify-center shadow">
    <%# `edit_open: true` — the owner's gear-triggered dialog inside `profile_header`
        renders pre-opened, so the form is usable with JS off. %>
    <%= render "profile_header", user: @user, edit_open: true %>
  </div>
</main>
