<%# Successful profile update: refresh the header card in place, then close the edit
    modal remotely via the custom `close_dialog` Turbo Stream action (registered in
    application.js). %>
<%= turbo_stream.replace dom_id(@user, :profile_header) do %>
  <%= render "profile_header", user: @user %>
<% end %>
<%# Refresh the always-visible navbar avatar too (Issue #13): the tile shows gradient
    initials from the name, so a full_name/username change leaves the bar stale until the
    next navigation. `@user` is the owner editing their own profile, so `current_user ==
    @user` and this dom_id matches the navbar target; if the target isn't on the page the
    Turbo replace is a harmless no-op. %>
<%= turbo_stream.replace dom_id(@user, :nav_avatar) do %>
  <%= render "shared/nav_current_user_avatar", user: @user %>
<% end %>
<turbo-stream action="close_dialog" target="<%= dom_id(@user, :edit_dialog) %>"></turbo-stream>
