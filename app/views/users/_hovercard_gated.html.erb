<%# Slice B hovercard body — GATED variant (private account the viewer may not see).
    Mirrors users/_gated_header's whitelist: avatar, full name, @handle, a "Private account"
    lock line, the follow/request button, and the follower/following COUNTS only. This is the
    leak boundary — NO headline / location / link / badges (those would leak content). Counts
    read the counter-cache columns, never .followers.size. Locals: user. %>
<div class="p-3 w-72">
  <div class="flex items-center gap-3">
    <%= render "ui/avatar", user: user, size: :md %>
    <div class="min-w-0">
      <div class="font-bold text-ink truncate"><%= user.full_name %></div>
      <div class="text-xs text-ink-2 truncate">@<%= user.username %></div>
    </div>
  </div>

  <div class="mt-2 flex items-center gap-1 text-sm text-ink-2">
    <%= lucide_icon("lock", class: "w-4 h-4") %>
    <span>Private account</span>
  </div>

  <div class="mt-2 flex items-center gap-3 text-sm text-ink-2">
    <%= render "users/follower_count", user: user %>
    <span class="flex items-center gap-1">
      <%= lucide_icon("user-plus", class: "w-4 h-4") %>
      <span><%= user.following_count %></span>
    </span>
  </div>

  <div class="mt-3">
    <%= render "users/follow_button", user: user %>
  </div>
</div>
