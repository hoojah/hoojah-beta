<%# Public profile screen — faithful port of the legacy SPA `UserProfile.jsx`:
    the primary-colored header card (with the owner's edit pencil + modal), then the
    user's hoojahs as compact cards. %>
<% owner = user_signed_in? && current_user.id == @user.id %>

<%= render "shared/navbar" %>

<main class="max-w-xl mx-auto px-4 py-6">
  <div class="relative flex justify-center shadow">
    <%# Slice 7b (Gate 4): a private account the viewer can't see renders the gated
        header (no hoojah list). The owner always sees their own full profile + editor. %>
    <% if @gated %>
      <%= render "gated_header", user: @user %>
    <% else %>
      <%= render "profile_header", user: @user %>
      <% if owner %>
        <%= render "profile_edit", user: @user %>
      <% end %>
    <% end %>
  </div>

  <% unless @gated %>
    <div class="mt-2 flex flex-col">
      <% if @hujahs.any? %>
        <%= render partial: "user_hujah", collection: @hujahs, as: :hujah %>
      <% else %>
        <div class="flex items-center text-sm text-light-grey fill-light-grey card-body p-3 bg-white">
          <%= lucide_icon("message-circle", class: "w-4 h-4") %>
          <span class="ml-1">No response yet</span>
        </div>
      <% end %>
    </div>
  <% end %>
</main>
