<%# Faithful port of the legacy SPA `UserProfile.jsx` header column: avatar, name,
    @handle, headline, optional location + link, and the vote/hoojah counts.
    Root carries `dom_id(user, :profile_header)` so update.turbo_stream.erb can
    replace just this block after an edit. Locals: user. %>
<div id="<%= dom_id(user, :profile_header) %>"
     class="w-full bg-primary text-white fill-white flex flex-col items-center py-6 px-4">
  <%= image_tag user.photo, class: "rounded-full mb-3 w-24 h-24 object-cover", alt: user.username %>
  <h5 class="mb-0 text-lg font-medium"><%= user.full_name %></h5>
  <div class="mb-3">@<%= user.username %></div>

  <%# Follow button (signed-in non-owner only; self-wraps in dom_id for Turbo). %>
  <div class="mb-3">
    <%= render "follow_button", user: user %>
  </div>

  <%# Achievement badges (public). Each chip is a Lucide icon + name with the
      description as a `title` tooltip. %>
  <% if user.badges.any? %>
    <div class="mb-3 flex flex-wrap justify-center gap-2">
      <% user.badges.each do |badge| %>
        <span class="inline-flex items-center gap-1 text-xs bg-white/20 rounded-full px-2 py-1"
              title="<%= badge[:description] %>">
          <%= lucide_icon(badge[:icon], class: "w-3.5 h-3.5") %>
          <%= badge[:name] %>
        </span>
      <% end %>
    </div>
  <% end %>

  <% if user.headline.present? %>
    <div class="mb-3 text-center"><%= user.headline %></div>
  <% end %>

  <% if user.location.present? %>
    <div class="text-sm mb-1 flex items-center gap-1">
      <%= lucide_icon("map-pin", class: "w-4 h-4") %> <%= user.location %>
    </div>
  <% end %>
  <% if user.link.present? %>
    <div class="text-sm mb-1 flex items-center gap-1">
      <%= lucide_icon("globe", class: "w-4 h-4") %>
      <%= link_to user.link, user.link, target: "_blank", rel: "noopener nofollow", class: "text-white underline" %>
    </div>
  <% end %>

  <div class="text-sm mt-1 flex items-center gap-1">
    <%= lucide_icon("bar-chart-2", class: "w-4 h-4") %>
    <span><%= user.votes.size %></span>
    <span class="mx-2">·</span>
    <%= lucide_icon("message-circle", class: "w-4 h-4") %>
    <span><%= user.hujahs.size %></span>
    <span class="mx-2">·</span>
    <%= link_to user_followers_path(user.username), class: "flex items-center gap-1 text-white" do %>
      <%= render "follower_count", user: user %>
    <% end %>
    <span class="mx-2">·</span>
    <%= link_to user_following_path(user.username), class: "flex items-center gap-1 text-white" do %>
      <%= lucide_icon("user-plus", class: "w-4 h-4") %>
      <span><%= user.following.size %></span>
    <% end %>
  </div>
</div>
