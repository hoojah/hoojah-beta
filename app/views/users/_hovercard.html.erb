<%# Slice B hovercard body — STANDARD variant (visible user). Content + padding only; the
    floating panel (Task 2's JS wrapper) provides the bg/shadow/rounded chrome. Counts read
    the counter-cache columns (followers_count / following_count) — via the shared
    users/_follower_count chip for followers, mirrored inline for following — NEVER
    .followers.size. Locals: user. %>
<div class="p-3 w-72">
  <div class="flex items-center gap-3">
    <%= render "ui/avatar", user: user, size: :md %>
    <div class="min-w-0">
      <div class="font-bold text-ink truncate"><%= user.full_name %></div>
      <div class="text-xs text-ink-2 truncate">@<%= user.username %></div>
    </div>
  </div>

  <% if user.headline.present? %>
    <p class="mt-2 text-sm text-ink-2 line-clamp-2"><%= user.headline %></p>
  <% end %>

  <div class="mt-2 flex items-center gap-3 text-sm text-ink-2">
    <%= render "users/follower_count", user: user %>
    <span class="flex items-center gap-1">
      <%= lucide_icon("user-plus", class: "w-4 h-4") %>
      <span><%= user.following_count %></span>
    </span>
  </div>

  <div class="mt-3">
    <%= render "users/follow_button", user: user %>
  </div>
</div>
