<%# One notification row — faithful port of the legacy SPA `Notifications/card.js`.
    Left border colored read/unread; a category-specific Lucide icon + copy; the body
    is a PATCH button (mark read → redirect to the hoojah); a trash button DELETEs it
    (Turbo-Stream removes this card). Locals: notification. %>
<% read = notification.read? %>
<div id="<%= dom_id(notification) %>"
     class="shadow border-l-8 border-<%= read ? "read" : "unread" %> pr-2 flex items-center mb-1 bg-white">
  <div class="flex items-center py-1 w-full">
    <div class="flex items-center ml-3 fill-grey shrink-0">
      <% case notification.category %>
      <% when "announcement" %>
        <%= lucide_icon("megaphone", class: "w-4 h-4") %>
      <% when "new_hoojah_response" %>
        <%= lucide_icon("message-circle", class: "w-4 h-4") %>
      <% when "new_vote" %>
        <%= lucide_icon("bar-chart-3", class: "w-4 h-4") %>
      <% when "mention" %>
        <%= lucide_icon("at-sign", class: "w-4 h-4") %>
      <% when "new_follower" %>
        <%= lucide_icon("user-plus", class: "w-4 h-4") %>
      <% when "follow_request" %>
        <%= lucide_icon("user-plus", class: "w-4 h-4") %>
      <% when "follow_accepted" %>
        <%= lucide_icon("user-check", class: "w-4 h-4") %>
      <% when "badge_earned" %>
        <%= lucide_icon("award", class: "w-4 h-4") %>
      <% end %>
    </div>

    <div class="flex flex-col text-sm text-grey pr-1 ml-3 min-w-0">
      <span>
        <% case notification.category %>
        <% when "announcement" %>
          Announcement
        <% when "new_hoojah_response" %>
          @<%= notification.subject_user&.username %> posted a new argument on your hoojah
        <% when "new_vote" %>
          You have a new vote on your hoojah
        <% when "mention" %>
          @<%= notification.subject_user&.username %> mentioned you in a hoojah
        <% when "new_follower" %>
          @<%= notification.subject_user&.username %> started following you
        <% when "follow_request" %>
          @<%= notification.subject_user&.username %> requested to follow you
        <% when "follow_accepted" %>
          @<%= notification.subject_user&.username %> accepted your follow request
        <% when "badge_earned" %>
          You earned the <strong><%= Badge::REGISTRY.dig(notification.body, :name) || "achievement" %></strong> badge
        <% end %>
      </span>

      <% if notification.category == "announcement" %>
        <%= button_to notification_path(notification), method: :patch,
              class: "text-left p-0 bg-transparent border-0 text-grey truncate no-underline" do %>
          <%= notification.body %>
        <% end %>
      <% elsif notification.hujah && notification.hujah.visible_to?(current_user) %>
        <%# Slice 7b (Gate 9, N-1): only render the hoojah body if the recipient may
            actually see it — a private author's hoojah body must not leak through a
            mention/response notification to a non-follower. %>
        <%= button_to notification_path(notification), method: :patch,
              class: "block text-left p-0 bg-transparent border-0 text-grey truncate no-underline max-w-[350px]" do %>
          <%= format_body(notification.hujah.body) %>
        <% end %>
      <% elsif notification.new_follower? && notification.subject_user %>
        <%= link_to "View profile", profile_path(notification.subject_user.username),
              class: "text-left text-primary no-underline" %>
      <% elsif notification.follow_request? && (req_follow = Follow.find_by(follower_id: notification.subject_user_id, followed_id: notification.user_id)) %>
        <%# Accept/decline the pending request in place (Slice 7b). Both button_to's
            hit /follow_requests/:id; FollowRequestPolicy restricts them to this user. %>
        <div class="flex items-center gap-3">
          <%= button_to "Accept", follow_request_path(req_follow), method: :patch,
                class: "text-left p-0 bg-transparent border-0 text-primary no-underline" %>
          <%= button_to "Decline", follow_request_path(req_follow), method: :delete,
                class: "text-left p-0 bg-transparent border-0 text-grey no-underline" %>
        </div>
      <% elsif notification.follow_accepted? && notification.subject_user %>
        <%= link_to "View profile", profile_path(notification.subject_user.username),
              class: "text-left text-primary no-underline" %>
      <% elsif notification.badge_earned? %>
        <%# badge_earned has no hujah/subject_user, so add its own mark-read affordance. %>
        <%= button_to "Mark as read", notification_path(notification), method: :patch,
              class: "text-left p-0 bg-transparent border-0 text-primary no-underline" %>
      <% end %>
    </div>

    <%= button_to notification_path(notification), method: :delete,
          class: "flex items-center ml-auto mr-2 fill-grey bg-transparent border-0 p-0",
          aria: {label: "Delete notification"} do %>
      <%= lucide_icon("trash-2", class: "w-4 h-4") %>
    <% end %>
  </div>
</div>
