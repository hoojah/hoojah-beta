<%# Compact trending list — reused by the lazy sidebar frame on the feed and by
    the standalone /trending page. Locals: hujahs.

    DESIGN SYSTEM (Slice 9, Task 4.4) —
    docs/design-system/components/social/TrendingList.prompt.md: "no numbers, no rank
    badges. Bodies truncate at ~90 characters. Empty copy is exactly 'Nothing trending
    yet.'" Those still hold — resist adding a rank number. The sidebar row now sits on a
    compact `ui/_card` surface with an accent (`text-neutral`) heading, so each row is a
    discrete card whose whole surface is the link; body text stays grey and hovers to
    primary. The empty line moves onto `ui/_empty_state` for the same wording in the
    same place, `icon: nil` because this one is a bare sentence and `lucide_icon(nil)`
    raises, `tone: :muted` because grey is what the prompt asks for and faint is the
    partial's default. The padding is zeroed through all three longhands rather than a
    `p-0`: `p-0` and the partial's baked `p-3` are the same Tailwind family and resolve
    by bundle order, where `.p-0` comes FIRST and therefore loses (see the partial's
    own header). `px-* pt-* pb-*` are emitted after the shorthand and do win. %>
<section aria-label="Trending hoojahs">
  <h2 class="text-sm font-semibold text-neutral uppercase tracking-wide mb-2 flex items-center gap-1">
    <%= lucide_icon("flame", class: "w-4 h-4") %> Trending
  </h2>

  <% if hujahs.any? %>
    <ul class="space-y-2 list-none p-0 m-0">
      <% hujahs.each do |hujah| %>
        <li>
          <%# Slice B (hovercard): the row is no longer a single outer <a>. Stretched-link
              pattern — a `relative` container, an inset overlay anchor to the hoojah
              (`absolute inset-0`, aria-label carries the body so `click_link "<body>"`
              and screen readers still resolve it), and the `@handle` lifted above it as a
              `ui/_user_link` (`relative z-10`) so it gets its own profile link + hovercard
              without nesting an <a> in an <a>. The overlay keeps `hover:text-primary`. %>
          <%= render layout: "ui/card", locals: {as: "article", padded: false, class: "rounded-xl"} do %>
            <div class="relative block p-3 text-sm text-grey">
              <%= link_to hujah_path(hujah.slug), class: "absolute inset-0 z-0 hover:text-primary",
                    "aria-label": truncate(strip_tags(hujah.body.to_s), length: 90) do %><% end %>
              <%= truncate(strip_tags(hujah.body.to_s), length: 90) %>
              <%= render layout: "ui/user_link", locals: {user: hujah.user, class: "relative z-10 block text-xs text-grey/70 mt-0.5"} do %>@<%= hujah.user.username %><% end %>
            </div>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <%= render "ui/empty_state", message: "Nothing trending yet.", icon: nil,
          tone: :muted, class: "px-0 pt-0 pb-0" %>
  <% end %>
</section>
