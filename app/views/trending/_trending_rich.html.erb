<%# Rich, ranked trending cards — the standalone /trending page ONLY (Hoojah 2026
    redesign, Phase 2.5; mockup ~lines 816-878). The feed's lazy sidebar frame keeps
    rendering the untouched, minimal `trending/_trending` partial — see
    `trending/index.html.erb`, which picks between the two via `turbo_frame_request?`.

    Locals: hujahs — must be `Hujah.trending`'s own result, in its own order. This
    partial does not query, sort, or filter; it only renders rank 1 as a gradient
    hero and the rest as compact ranked cards, in the order it's given.

    Deliberately NOT in this partial: a period toggle (Today/Week), a %-delta badge,
    or category-vote chips — the mockup has all three, but none of that data exists
    on `Hujah.trending` (a single ids-cached, already-ranked set), and inventing it
    here would mean a second query/filter this task explicitly rules out. %>
<section aria-label="Trending hoojahs">
  <h2 class="text-sm font-semibold text-grey uppercase tracking-wide mb-2 flex items-center gap-1">
    <%= lucide_icon("flame", class: "w-4 h-4") %> Trending
  </h2>

  <% if hujahs.any? %>
    <ol class="list-none p-0 m-0 flex flex-col gap-3">
      <% hujahs.each_with_index do |hujah, index| %>
        <% total_votes = hujah.agree_count.to_i + hujah.neutral_count.to_i + hujah.disagree_count.to_i %>
        <li>
          <% if index.zero? %>
            <%= link_to hujah_path(hujah.slug), class: "no-underline block" do %>
              <div class="rounded-3xl trending-hero shadow p-4" data-testid="trending-hero">
                <div class="flex items-center gap-2.5">
                  <span class="text-3xl font-black leading-none opacity-55">1</span>
                  <span class="ml-auto text-xs font-semibold opacity-85"><%= total_votes %> <%= "vote".pluralize(total_votes) %></span>
                </div>
                <div class="mt-2.5 text-base font-bold leading-snug">
                  <%= truncate(strip_tags(hujah.body.to_s), length: 140) %>
                </div>
              </div>
            <% end %>
          <% else %>
            <%= link_to hujah_path(hujah.slug), class: "no-underline block" do %>
              <div class="rounded-2xl bg-card shadow p-3.5 flex gap-3 items-center" data-testid="trending-rank-card">
                <span class="text-2xl font-black leading-none text-faint w-6 text-center shrink-0"><%= index + 1 %></span>
                <div class="min-w-0 flex-1">
                  <div class="text-sm font-semibold leading-snug text-ink">
                    <%= truncate(strip_tags(hujah.body.to_s), length: 100) %>
                  </div>
                  <div class="mt-1.5 text-xs font-semibold text-ink-2">
                    <%= total_votes %> <%= "vote".pluralize(total_votes) %>
                  </div>
                </div>
              </div>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ol>
  <% else %>
    <%= render "ui/empty_state", message: "Nothing trending yet.", icon: nil,
          tone: :muted, class: "px-0 pt-0 pb-0" %>
  <% end %>
</section>
