<%# "Load more" on the tag feed: append the next page of the SAME hujahs/_hujah_card
    partial, then swap the load-more control for the next page's (or nothing, last page).
    Mirrors hujahs/index.turbo_stream.erb so page 2 can never drift from page 1. %>
<%= turbo_stream.append "hujah-feed" do %>
  <%= render partial: "hujahs/hujah_card", collection: @hujahs, as: :hujah %>
<% end %>

<%= turbo_stream.replace "load-more" do %>
  <div id="load-more">
    <%= render "load_more" if @pagy.next %>
  </div>
<% end %>
