<%# Hoojah 2026 threaded response card (mockup hoojah-2026-single-hoojah.html lines
    ~176-231): a rounded `bg-card` card with a 6px stance-coloured LEFT border strip —
    the signature Hoojah motif — the responder's byline (name · @handle · stance · time),
    the argument body, and a stance-tally footer.

    FROZEN (response filter): the whole card is the filter's item anchor —
    `data-response-filter-target="item"` / `data-response-filter-vote="<stance>"` on the
    <a>. `response_filter_controller` matches those by string against `_response_filter`
    and `_challenge_dialog`; they stay spelled exactly. Stance names are interpolated into
    `bg-<stance>` / `text-<stance>` (all in the @source inline safelist); the `-soft`
    pairs come from a literal lookup (below) so no new interpolated prefix ships.

    Locals: child (the response hoojah), hujah (the root claim), and the optional
    `live_debate_keys` set (from `_response_filter`) used to show the "In debate" badge.

    The "Challenge to debate" affordance and the "In debate" badge render OUTSIDE the card
    anchor (a nested <a> is invalid HTML) — CompactHujahCard.prompt.md: "renders below the
    card, never inside it". Each carries the same response-filter item+vote so it hides in
    sync with its card. The challenge affordance is gated to a signed-in non-author AND
    `hujah.allow_debates?` (2026). When the response already has a live/pending debate the
    badge replaces the challenge trigger.

    2026 Phase 3.2: the affordance is a plain LINK to the debate create page
    (`new_hujah_debate_path`), not the stance-only `hujahs/_challenge_dialog` <dialog> it
    used to open — that partial is kept on disk (its FROZEN block documents what still
    points at it) but nothing renders it from here any more. The create page collects the
    stance itself, so this link carries no `challenger_stance`. %>
<% stance = {1 => "agree", 2 => "neutral", 3 => "disagree"}[child.vote] || "primary" %>
<% soft = {
     "agree" => "bg-agree-soft text-agree",
     "neutral" => "bg-neutral-soft text-neutral",
     "disagree" => "bg-disagree-soft text-disagree",
     "primary" => "bg-primary-soft text-primary"
   }[stance] %>
<% in_debate = local_assigns[:live_debate_keys]&.include?([child.user_id, child.vote]) %>
<%= link_to hujah_path(child.slug),
      class: "block no-underline mb-2.5",
      data: { "response-filter-target": "item", "response-filter-vote": stance } do %>
  <div class="flex overflow-hidden rounded-2xl bg-card shadow">
    <div class="w-1.5 shrink-0 bg-<%= stance %>"></div>
    <div class="flex-1 min-w-0 p-3.5">
      <div class="flex items-center gap-2.5">
        <%= render "ui/avatar", user: child.user, size: :sm %>
        <div class="flex flex-col min-w-0 leading-tight">
          <div class="text-sm font-bold text-ink truncate"><%= child.user.full_name %></div>
          <div class="text-xs text-ink-2">
            @<%= child.user.username %>
            <% if child.vote %>
              <span class="mx-0.5">·</span>
              <span class="font-bold text-<%= stance %>"><%= stance.capitalize %></span>
            <% end %>
            <span class="mx-0.5">·</span>
            <time datetime="<%= child.created_at.iso8601 %>" data-local="time-ago"><%= child.created_at.strftime("%b %-d") %></time>
          </div>
        </div>
      </div>
      <div class="mt-2 text-sm leading-relaxed text-ink break-words"><%= format_body(child.body) %></div>
      <%# Secret ballot (2a/A7): the per-stance tally is a de-anonymization vector below
          k=5 total votes — replaced by the total-only label until the electorate grows. %>
      <div class="mt-3 flex items-center gap-4 text-xs text-ink-2 font-semibold">
        <% if child.breakdown_visible? %>
          <span class="inline-flex items-center gap-1"><%= stance_icon("agree", class: "w-3.5 h-3.5") %><%= child.agree_count.to_i %></span>
          <span class="inline-flex items-center gap-1"><%= stance_icon("neutral", class: "w-3.5 h-3.5") %><%= child.neutral_count.to_i %></span>
          <span class="inline-flex items-center gap-1"><%= stance_icon("disagree", class: "w-3.5 h-3.5") %><%= child.disagree_count.to_i %></span>
        <% else %>
          <span><%= vote_total_label(child) %></span>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<% if in_debate %>
  <div data-response-filter-target="item" data-response-filter-vote="<%= stance %>"
       class="flex justify-end -mt-1 mb-2.5 pr-2">
    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold <%= soft %>">
      <%= lucide_icon("swords", class: "w-3.5 h-3.5") %> In debate
    </span>
  </div>
<% elsif user_signed_in? && current_user.id != child.user_id && hujah.allow_debates? %>
  <div data-response-filter-target="item" data-response-filter-vote="<%= stance %>"
       class="flex justify-end -mt-1 mb-1 pr-2">
    <%= link_to new_hujah_debate_path(hujah, argument_id: child.id),
          class: "#{ds_button_classes(variant: :link, tone: "neutral")} text-xs" do %>
      <%= lucide_icon("swords", class: "w-3.5 h-3.5") %> Challenge to debate
    <% end %>
  </div>
<% end %>
