<%# Hoojah 2026 ARGUMENT composer bar (mockup lines ~236-288) — the sticky "make your
    argument" control on the single-hoojah page. Three states driven by
    `argument_composer_controller`: locked / collapsed / expanded.

    Locals: hujah (the root claim), voted (bool — has the viewer voted on this claim?).

    The bar replaces the old "Add hoojah" link. `respond_hujah_path` is kept as the no-JS
    fallback (the full-page `_compose_form` reply flow is the JS-off baseline, and the
    "expand to full page" control links straight to it). The locked state mirrors the
    server gate: HujahPolicy#create? refuses a reply until the viewer has voted. An inline
    vote re-renders this partial with voted: true (votes/create.turbo_stream.erb), which
    unlocks it.

    Self-wraps in dom_id(hujah, :argument_composer) so the vote + reply Turbo Streams can
    replace it in place. %>
<%
  current_stance = hujah.current_user_vote(logged_in: user_signed_in?, current_user_id: current_user&.id)
  stance_num = {"agree" => 1, "neutral" => 2, "disagree" => 3}[current_stance] || 1
  stance_meta = [["agree", "thumbs-up", 1], ["neutral", "minus", 2], ["disagree", "thumbs-down", 3]]
%>
<div id="<%= dom_id(hujah, :argument_composer) %>"
     data-controller="argument-composer"
     data-argument-composer-voted-value="<%= voted %>"
     class="mt-4 mb-2 rounded-2xl bg-card-2 border border-hairline p-3">

  <%# LOCKED — must vote first. %>
  <div data-argument-composer-target="locked" <%= "hidden" if voted %>>
    <div class="flex items-center gap-2.5">
      <div class="flex-1 flex items-center gap-2 h-11 px-3.5 rounded-full bg-card border border-dashed border-field">
        <%= lucide_icon("lock", class: "w-4 h-4 text-faint") %>
        <span class="flex-1 text-sm text-faint font-semibold">Vote to join the argument</span>
      </div>
      <div class="flex gap-1.5 shrink-0">
        <% stance_meta.each do |stance, icon, _num| %>
          <a href="#<%= dom_id(hujah, :vote_hero) %>"
             aria-label="<%= stance.capitalize %>"
             class="w-9 h-9 rounded-full border-2 border-<%= stance %> bg-card text-<%= stance %> flex items-center justify-center no-underline active:scale-95">
            <%= lucide_icon(icon, class: "w-4 h-4") %>
          </a>
        <% end %>
      </div>
    </div>
    <%= link_to "Respond on a full page", respond_hujah_path(hujah.slug),
          class: "block mt-2 text-center text-xs font-semibold text-primary no-underline" %>
  </div>

  <%# COLLAPSED — pill; tap to expand. %>
  <div data-argument-composer-target="collapsed" <%= "hidden" unless voted %>>
    <div class="flex items-center gap-2.5">
      <button type="button"
              data-argument-composer-target="pill"
              data-action="argument-composer#expand"
              class="flex-1 flex items-center h-11 px-3.5 rounded-full bg-card border border-hairline text-left cursor-text">
        <span class="flex-1 text-sm text-faint">Make your argument…</span>
      </button>
      <button type="button"
              data-action="argument-composer#expand"
              aria-label="Make your argument"
              class="w-11 h-11 rounded-full border-none bg-primary text-white flex items-center justify-center shrink-0 shadow-lg active:scale-95">
        <%= lucide_icon("send", class: "w-5 h-5") %>
      </button>
    </div>
    <%= link_to "Respond on a full page", respond_hujah_path(hujah.slug),
          class: "block mt-2 text-center text-xs font-semibold text-primary no-underline" %>
  </div>

  <%# EXPANDED — stance row + textarea + Send. A real form_with POST /hoojah. %>
  <div data-argument-composer-target="expanded" hidden style="animation:hrise .3s cubic-bezier(.34,1.56,.64,1);">
    <%= form_with model: Hujah.new, url: "/hoojah", method: :post do |f| %>
      <%= hidden_field_tag "hujah[parent_id]", hujah.id %>
      <%= hidden_field_tag "hujah[vote]", stance_num, data: {"argument-composer-target": "stanceField"} %>

      <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-bold text-ink-2">Post this response as</span>
        <%= link_to respond_hujah_path(hujah.slug),
              aria: {label: "Open the full-page composer"},
              class: "w-8 h-8 rounded-lg bg-card flex items-center justify-center text-ink-2 no-underline" do %>
          <%= lucide_icon("maximize-2", class: "w-4 h-4") %>
        <% end %>
      </div>

      <div class="flex gap-2">
        <% stance_meta.each do |stance, icon, num| %>
          <button type="button"
                  data-action="argument-composer#pickStance"
                  data-value="<%= num %>"
                  aria-label="<%= stance.capitalize %>"
                  class="flex-1 inline-flex items-center justify-center gap-1.5 py-2 rounded-xl border-2 border-<%= stance %> text-<%= stance %> bg-card text-xs font-bold active:scale-95">
            <%= lucide_icon(icon, class: "w-4 h-4") %> <%= stance.capitalize %>
          </button>
        <% end %>
      </div>

      <div class="mt-2 flex items-end gap-2">
        <%# Issue #11: markdown emphasis toolbar, sharing the textarea with the
            argument-composer controller (both target the same element). %>
        <div data-controller="format-toolbar" class="flex-1">
          <div class="flex items-center gap-1 mb-1">
            <button type="button" data-action="format-toolbar#bold" aria-label="Bold"
              class="w-7 h-7 rounded-lg flex items-center justify-center text-ink-2 bg-card active:scale-95">
              <%= lucide_icon("bold", class: "w-3.5 h-3.5") %>
            </button>
            <button type="button" data-action="format-toolbar#italic" aria-label="Italic"
              class="w-7 h-7 rounded-lg flex items-center justify-center text-ink-2 bg-card active:scale-95">
              <%= lucide_icon("italic", class: "w-3.5 h-3.5") %>
            </button>
            <button type="button" data-action="format-toolbar#underline" aria-label="Underline"
              class="w-7 h-7 rounded-lg flex items-center justify-center text-ink-2 bg-card active:scale-95">
              <%= lucide_icon("underline", class: "w-3.5 h-3.5") %>
            </button>
          </div>
          <textarea name="hujah[body]"
                    data-argument-composer-target="body"
                    data-format-toolbar-target="field"
                    data-action="input->argument-composer#input"
                    placeholder="Make your argument…"
                    rows="2"
                    class="w-full border-none bg-card rounded-xl p-3 resize-none outline-none text-sm leading-relaxed text-ink"></textarea>
        </div>
        <button type="submit"
                data-argument-composer-target="send"
                disabled
                class="inline-flex items-center gap-1.5 px-4 h-11 rounded-full border-none bg-primary text-white font-bold text-sm shrink-0 shadow-lg active:scale-95 disabled:opacity-50">
          <%= lucide_icon("send", class: "w-4 h-4") %> Send
        </button>
      </div>
    <% end %>
  </div>
</div>
