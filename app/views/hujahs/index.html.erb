<%# The feed. DESIGN SYSTEM (Slice 9, Task 4.3): the layout here already IS the
    design system's page shape and is left alone — a `max-w-xl` (576px) centred content
    column, and on `lg` a 256px (`w-64`) trending sidebar beside it. The cards inside
    stack with their own 8px gaps, which is why this column sets no `gap`. %>
<%= render "shared/navbar" %>

<main class="max-w-5xl mx-auto px-4 py-6 lg:flex lg:gap-8 lg:justify-center">
  <div class="w-full max-w-xl mx-auto lg:mx-0">
    <%= render "shared/pinned" unless user_signed_in? %>

    <%= render "feed_tabs" %>

    <%# Inline feed composer (2026) — signed-in only. Collapsed pill expands to a Turbo
        form that prepends the new card to #hujah-feed via create.turbo_stream.erb. %>
    <%= render "hujahs/inline_composer" if user_signed_in? %>

    <%# Empty states. Following stays a centred two-clause paragraph (documented above);
        the global/default feed gets the design-system primitive with a key-funnel CTA. %>
    <% if @hujahs.empty? %>
      <% if params[:filter] == "following" && user_signed_in? %>
        <p class="text-center text-grey py-8">
          When people you follow post, you'll see it here.
        </p>
      <% elsif user_signed_in? %>
        <%= render "ui/empty_state", message: "No hoojahs yet", align: :center,
              cta_label: "Post the first hoojah", cta_href: new_hujah_path %>
      <% else %>
        <%= render "ui/empty_state",
              message: "No hoojahs yet — sign up to start the conversation", align: :center,
              cta_label: "Sign up", cta_href: new_user_registration_path %>
      <% end %>
    <% end %>

    <div id="hujah-feed">
      <%= render partial: "hujah_card", collection: @hujahs, as: :hujah %>
    </div>

    <div id="load-more">
      <%= render "load_more" if @pagy.next %>
    </div>
  </div>

  <%# Trending sidebar — wide viewports only; lazily loads the public /trending
      frame so the feed's first paint isn't blocked on the cache compute. %>
  <aside class="hidden lg:block w-64 shrink-0">
    <%= turbo_frame_tag "trending", src: trending_path, loading: :lazy, target: "_top" %>
    <%# Public footer links card (FAQ / Privacy / Terms + copyright), below trending —
        desktop sidebar only, so it never shows on the mobile feed. %>
    <%= render "shared/footer_links" %>
  </aside>
</main>
