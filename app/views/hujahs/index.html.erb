<%= render "shared/navbar" %>

<main class="max-w-xl mx-auto px-4 py-6">
  <%= render "shared/pinned" unless user_signed_in? %>

  <%= render "feed_tabs" %>

  <% if params[:filter] == "following" && user_signed_in? && @hujahs.empty? %>
    <p class="text-center text-grey py-8">
      Your Following feed is empty. Follow some people to see their hoojahs here.
    </p>
  <% end %>

  <div id="hujah-feed">
    <%= render partial: "hujah_card", collection: @hujahs, as: :hujah %>
  </div>

  <div id="load-more">
    <%= render "load_more" if @pagy.next %>
  </div>
</main>
