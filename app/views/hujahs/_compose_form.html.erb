<%# The 2026 "New hoojah" composer (Track 4, Task 4.3). Visual target:
    docs/superpowers/specs/assets/hoojah-2026-newpost.html (the full-screen overlay).
    Server-rendered form_with over the composer Stimulus controller — the whole screen
    still POSTs a valid hoojah with JS off (the Post button is NOT server-disabled; the
    composer controller disables it on connect until 8 chars, and the model's 8-char
    validation is the real guard). Theme-token utilities only (bg-card/text-ink/…), no
    raw hex, so the screen follows the runtime theme/scheme (Track 1).

    TOP-LEVEL compose (parent nil): author row + visibility dropdown + suggested-hashtag
    chips + the "How people will weigh in" preview + the Allow-debates toggle.
    REPLY (parent present): keeps the legacy parent card + stance picker; the visibility
    control, suggested tags, and allow-debates toggle are top-level-only per the contract.

    The avatar is `ui/_avatar` at `md`; `image_tag current_user.photo` raises on a blank
    photo, so the partial's fallback matters here. %>
<%# edit_mode: optional `edit` local, falsy on every create/respond path. In edit mode
    the same form PATCHes the existing hoojah's body instead of POSTing a new one. %>
<% edit_mode = local_assigns[:edit] %>
<%# turbo: false — the full-page composer navigates on success (create redirects to the
    new hoojah). Without it the Turbo form would consume create.turbo_stream.erb, which
    prepends to the (absent) feed, leaving the user stranded on the composer. %>
<%= form_with model: hujah,
      url: (edit_mode ? hujah_path(hujah.slug) : "/hoojah"), method: (edit_mode ? :patch : :post), local: true,
      data: {turbo: false, controller: "composer", composer_require_min_value: parent.nil?},
      class: "min-h-screen flex flex-col bg-surface" do |f| %>
  <% if parent.present? %>
    <%= f.hidden_field :parent_id, value: parent.id %>
  <% end %>

  <header class="sticky top-0 z-20 flex items-center justify-between px-4 py-2 bg-card backdrop-blur border-b border-hairline">
    <%# Cancel returns to the hoojah being edited in edit mode; else to the parent (reply)
        or the feed (top-level compose). %>
    <%= link_to((edit_mode ? hujah_path(hujah.slug) : (parent.present? ? hujah_path(parent.slug) : root_path)),
          class: "w-10 h-10 rounded-2xl flex items-center justify-center text-ink no-underline", aria: {label: "Cancel"}) do %>
      <%= lucide_icon("x", class: "w-5 h-5") %>
    <% end %>
    <span class="text-[15px] font-extrabold text-ink"><%= edit_mode ? "Edit hoojah" : "New hoojah" %></span>
    <%= f.submit(edit_mode ? "Save" : "Post", data: {composer_target: "post"},
          class: "px-5 py-2 rounded-full border-2 border-primary text-primary bg-card font-bold text-sm transition active:scale-95 disabled:opacity-50 disabled:cursor-default") %>
  </header>

  <main class="flex-1 w-full max-w-xl mx-auto px-4 py-4 flex flex-col">
    <% if parent.present? %>
      <%= render "hujahs/parent_card", parent: parent %>
      <%# Stance is immutable on edit — hide the picker, keep the parent card for context. %>
      <%= render "hujahs/stance_picker", form: f, parent: parent unless edit_mode %>
    <% else %>
      <div class="flex items-center gap-2.5">
        <%= render "ui/avatar", user: current_user, size: :md %>
        <div class="relative leading-tight">
          <div class="text-sm font-bold text-ink"><%= current_user.full_name %></div>
          <%# Visibility (JS-off safe): a native <select> is the CANONICAL, always-submitted
              control — the old hidden_field + JS-only menu silently shipped Public whenever
              JS was off. Styled as the mockup's pill via `appearance-none` + an overlaid
              chevron, dark-safe theme tokens. There is exactly one hujah[visibility] field,
              so no double-submit; the composer controller only reads it, never adds another. %>
          <%# Visibility is immutable on edit — the select is hidden and never submitted. %>
          <% unless edit_mode %>
            <div class="relative inline-block mt-0.5">
              <%= f.select :visibility,
                    [["Public", "visible_public"], ["Followers", "followers_only"], ["Private", "private_only"]],
                    {}, data: {composer_target: "select"}, "aria-label": "Who can see this",
                    class: "appearance-none text-[11.5px] font-bold text-primary bg-primary-soft pl-2.5 pr-7 py-1 rounded-full cursor-pointer focus:outline-none" %>
              <span class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 text-primary">
                <%= lucide_icon("chevron-down", class: "w-2.5 h-2.5") %>
              </span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# Issue #11: markdown emphasis toolbar. The format-toolbar controller wraps the
        textarea selection with **/*/_ tokens (parsed server-side by format_body) and
        re-dispatches `input` so the composer counters stay in sync. Shares the textarea
        with the composer controller (both target the same element). %>
    <div data-controller="format-toolbar">
      <div class="flex items-center gap-1 mt-4">
        <button type="button" data-action="format-toolbar#bold" aria-label="Bold"
          class="w-8 h-8 rounded-lg flex items-center justify-center text-ink-2 bg-card-2 active:scale-95">
          <%= lucide_icon("bold", class: "w-4 h-4") %>
        </button>
        <button type="button" data-action="format-toolbar#italic" aria-label="Italic"
          class="w-8 h-8 rounded-lg flex items-center justify-center text-ink-2 bg-card-2 active:scale-95">
          <%= lucide_icon("italic", class: "w-4 h-4") %>
        </button>
        <button type="button" data-action="format-toolbar#underline" aria-label="Underline"
          class="w-8 h-8 rounded-lg flex items-center justify-center text-ink-2 bg-card-2 active:scale-95">
          <%= lucide_icon("underline", class: "w-4 h-4") %>
        </button>
      </div>
      <%= f.text_area :body, rows: 4, placeholder: "What's your hoojah?",
            data: {composer_target: "body", format_toolbar_target: "field", action: "input->composer#input"},
            "aria-label": "What's your hoojah?",
            class: "w-full mt-2 border-0 p-0 bg-transparent resize-none focus:ring-0 text-xl font-semibold leading-snug text-ink" %>
    </div>

    <%# Suggested hashtags + the weigh-in preview are compose-only affordances — the body
        edit hides them (stance/vote mechanics are immutable here). %>
    <% if parent.nil? && !edit_mode %>
      <div class="mt-auto pt-4">
        <% if Array(@suggested_tags).any? %>
          <div class="text-[11px] font-bold uppercase tracking-wide text-faint mb-2">Suggested hashtags</div>
          <div class="flex gap-2 flex-wrap">
            <% @suggested_tags.each do |tag| %>
              <button type="button" data-action="composer#addTag" data-tag="<%= tag.display %>"
                class="text-[12.5px] font-semibold px-3 py-1.5 rounded-full bg-card-2 text-ink-2">+ #<%= tag.display %></button>
            <% end %>
          </div>
        <% end %>

        <% if current_user.can_customize_stances? %>
          <%# Slice 3: eligible authors rename each stance inline. Tapping a word swaps it
              for an input; stance_labels_controller syncs the value into the adjacent
              hidden field. Discovered by tapping — no hints. Colours/icons stay keyed to
              the stance word, so no new interpolated Tailwind classes here. %>
          <div class="mt-3.5 rounded-2xl bg-card shadow p-3.5" data-controller="stance-labels">
            <div class="text-xs font-bold text-ink-2 mb-2.5">How people will weigh in</div>
            <div class="flex gap-2.5">
              <% {agree: "Agree", neutral: "Neutral", disagree: "Disagree"}.each do |stance, label| %>
                <div class="flex-1 flex flex-col items-center gap-1.5 text-<%= stance %>">
                  <span class="w-9 h-9 rounded-full border-2 border-<%= stance %> flex items-center justify-center">
                    <%= stance_icon(stance.to_s, class: "w-4 h-4") %>
                  </span>
                  <span class="text-[11px] font-bold cursor-text"
                        data-stance-labels-target="word"
                        data-default="<%= label %>"
                        data-action="click->stance-labels#edit"><%= label %></span>
                  <%= f.hidden_field :"#{stance}_label" %>
                </div>
              <% end %>
            </div>
          </div>
        <% else %>
          <div class="mt-3.5 rounded-2xl bg-card shadow p-3.5">
            <div class="text-xs font-bold text-ink-2 mb-2.5">How people will weigh in</div>
            <div class="flex gap-2.5">
              <% {agree: "Agree", neutral: "Neutral", disagree: "Disagree"}.each do |stance, label| %>
                <div class="flex-1 flex flex-col items-center gap-1.5 text-<%= stance %>">
                  <span class="w-9 h-9 rounded-full border-2 border-<%= stance %> flex items-center justify-center">
                    <%= stance_icon(stance.to_s, class: "w-4 h-4") %>
                  </span>
                  <span class="text-[11px] font-bold"><%= label %></span>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </main>

  <% if parent.nil? %>
    <footer class="flex items-center gap-3.5 px-4 py-3 bg-card backdrop-blur border-t border-hairline">
      <button type="button" aria-label="Add image"
        class="w-10 h-10 rounded-xl bg-card-2 flex items-center justify-center text-ink-2">
        <%= lucide_icon("image", class: "w-5 h-5") %>
      </button>
      <label class="flex items-center gap-2 text-[12.5px] font-semibold text-ink-2 cursor-pointer">
        Allow debates
        <span class="relative inline-block w-[38px] h-[22px]">
          <%= f.check_box :allow_debates, class: "sr-only peer" %>
          <span class="absolute inset-0 rounded-full bg-field peer-checked:bg-primary transition-colors"></span>
          <span class="absolute top-0.5 left-0.5 w-[18px] h-[18px] rounded-full bg-white peer-checked:translate-x-4 transition-transform"></span>
        </span>
      </label>
      <span class="ml-auto text-[12.5px] font-bold text-faint">Draft</span>
    </footer>
  <% end %>
<% end %>
