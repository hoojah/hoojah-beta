<%# Share menu — faithful port of the legacy SPA `Hujah/card_header.js` react-share
    dropdown (Facebook / X / WhatsApp / Telegram / Reddit / Email). Every target is a
    plain server-rendered <a href> built from the hoojah's ABSOLUTE url + body, so the
    whole menu works with JavaScript disabled. The `share` controller only progressively
    enhances: on a device with the Web Share API it unhides the native-share button.

    Locals: hujah. %>
<% share_url = hujah_url(hujah.slug) %>
<% share_text = "\"#{strip_tags(hujah.body)} (by @#{hujah.user.username})\" Do you AGREE? NEUTRAL? DISAGREE?" %>
<% share_title = "Hoojah by @#{hujah.user.username}" %>

<details class="relative shrink-0"
         data-controller="share"
         data-share-title-value="<%= share_title %>"
         data-share-text-value="<%= share_text %>"
         data-share-url-value="<%= share_url %>">
  <summary class="list-none cursor-pointer fill-light-grey text-light-grey" aria-label="Share this hoojah">
    <%= lucide_icon("share-2", class: "w-4 h-4") %>
  </summary>
  <div class="absolute right-0 mt-1 w-52 bg-white shadow rounded p-2 z-10">
    <h6 class="text-xs text-grey px-2 pb-1">Share this hoojah via</h6>

    <%# Native OS share sheet — hidden until the share controller confirms support. %>
    <button type="button" hidden
            data-share-target="button"
            data-action="share#share"
            class="w-full text-left px-3 py-1 text-black no-underline hover:bg-gray-100 rounded border-0 bg-transparent cursor-pointer">
      Share…
    </button>

    <%= link_to "WhatsApp", "https://wa.me/?text=#{CGI.escape("#{share_text} #{share_url}")}", target: "_blank", rel: "noopener", class: "block px-3 py-1 text-black no-underline hover:bg-gray-100 rounded" %>
    <%= link_to "X", "https://x.com/intent/tweet?url=#{CGI.escape(share_url)}&text=#{CGI.escape(share_text)}&via=hoojah_my", target: "_blank", rel: "noopener", class: "block px-3 py-1 text-black no-underline hover:bg-gray-100 rounded" %>
    <%= link_to "Telegram", "https://t.me/share/url?url=#{CGI.escape(share_url)}&text=#{CGI.escape(share_text)}", target: "_blank", rel: "noopener", class: "block px-3 py-1 text-black no-underline hover:bg-gray-100 rounded" %>
    <%= link_to "Reddit", "https://www.reddit.com/submit?url=#{CGI.escape(share_url)}&title=#{CGI.escape(share_text)}", target: "_blank", rel: "noopener", class: "block px-3 py-1 text-black no-underline hover:bg-gray-100 rounded" %>
    <%= link_to "Facebook", "https://www.facebook.com/sharer/sharer.php?u=#{CGI.escape(share_url)}", target: "_blank", rel: "noopener", class: "block px-3 py-1 text-black no-underline hover:bg-gray-100 rounded" %>
    <%= mail_to "hello@hoojah.my", "Email", subject: share_title, body: "#{share_text}\n\n#{share_url}", class: "block px-3 py-1 text-black no-underline hover:bg-gray-100 rounded" %>
  </div>
</details>
