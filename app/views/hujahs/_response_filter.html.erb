<%# Hoojah 2026 responses section (mockup lines ~162-233): a "Responses · N" heading, a
    horizontally-scrollable row of stance filter pills, then the stance-bordered response
    cards. The filtering is pure client-side show/hide (`response_filter_controller.js`) —
    no fetch, no re-render.

    FROZEN — the controller's whole API, matched by string in `_child_card` and
    `_challenge_dialog`:
      root:  data-controller="response-filter"
      tabs:  role="group", data-response-filter-target="tab",
             data-action="response-filter#filter",
             data-response-filter-filter-param="all|agree|neutral|disagree"
      items: data-response-filter-target="item" data-response-filter-vote="<stance>"
    Change a name here and half the thread stops hiding, silently. `empty` (below, inside
    the responses list) is a pure ADDITION to this contract, not a rename — the controller
    toggles it visible when a stance filter matches zero items. The tabs' active fill
    is driven by the built-in `aria-pressed:` variant the controller already toggles, so
    it needs no extra JS. Stance active-fills are spelled literally per stance (a loop
    would interpolate `aria-pressed:bg-<stance>` which the scanner can't see).

    `live_debate_keys` — the [opponent_id, opponent_stance] pairs of this claim's
    live/pending debates — is computed ONCE here and threaded to each `_child_card` so the
    "In debate" badge costs no per-card query. %>
<% live_debate_keys = hujah.debates.where(status: [:pending, :active]).pluck(:opponent_id, :opponent_stance).to_set %>
<%# Reply counts for the whole response row in ONE grouped query (same
    once-compute-then-thread pattern as live_debate_keys), so each card's
    "N replies" badge costs no per-card query. The count mirrors
    visible_children_for's gate, so it matches what the viewer would see after
    clicking through. %>
<% reply_counts = Hujah.visible_reply_counts_for(children.map(&:id), current_user) %>
<div data-controller="response-filter" data-response-filter-active-value="all">
  <div class="flex items-center justify-between mt-6 mb-2 px-1">
    <span class="text-base font-extrabold text-ink">
      Responses <span class="text-faint font-semibold">· <%= children.size %></span>
    </span>
  </div>

  <div role="group" aria-label="Filter responses" class="flex gap-2 overflow-x-auto pb-1 px-1">
    <button type="button"
            data-action="response-filter#filter"
            data-response-filter-filter-param="all"
            data-response-filter-target="tab"
            aria-pressed="true"
            class="shrink-0 inline-flex items-center gap-1 px-4 py-2 rounded-full text-xs font-bold bg-card-2 text-ink-2 aria-pressed:bg-primary aria-pressed:text-white">
      All <%= lucide_icon("message-circle", class: "w-3.5 h-3.5") %>
    </button>
    <button type="button"
            data-action="response-filter#filter"
            data-response-filter-filter-param="agree"
            data-response-filter-target="tab"
            aria-pressed="false"
            aria-label="Agree"
            class="group shrink-0 inline-flex items-center gap-1 px-4 py-2 rounded-full text-xs font-bold bg-card border-2 border-agree text-agree aria-pressed:bg-agree-soft aria-pressed:ring-2 aria-pressed:ring-agree">
      <%= lucide_icon("check", class: "w-3.5 h-3.5 hidden group-aria-pressed:inline") %>
      <%= stance_icon("agree", class: "w-3.5 h-3.5") %> Agree
    </button>
    <button type="button"
            data-action="response-filter#filter"
            data-response-filter-filter-param="neutral"
            data-response-filter-target="tab"
            aria-pressed="false"
            aria-label="Neutral"
            class="group shrink-0 inline-flex items-center gap-1 px-4 py-2 rounded-full text-xs font-bold bg-card border-2 border-neutral text-neutral aria-pressed:bg-neutral-soft aria-pressed:ring-2 aria-pressed:ring-neutral">
      <%= lucide_icon("check", class: "w-3.5 h-3.5 hidden group-aria-pressed:inline") %>
      <%= stance_icon("neutral", class: "w-3.5 h-3.5") %> Neutral
    </button>
    <button type="button"
            data-action="response-filter#filter"
            data-response-filter-filter-param="disagree"
            data-response-filter-target="tab"
            aria-pressed="false"
            aria-label="Disagree"
            class="group shrink-0 inline-flex items-center gap-1 px-4 py-2 rounded-full text-xs font-bold bg-card border-2 border-disagree text-disagree aria-pressed:bg-disagree-soft aria-pressed:ring-2 aria-pressed:ring-disagree">
      <%= lucide_icon("check", class: "w-3.5 h-3.5 hidden group-aria-pressed:inline") %>
      <%= stance_icon("disagree", class: "w-3.5 h-3.5") %> Disagree
    </button>
  </div>

  <%# id is the append target for a freshly-posted argument (create.turbo_stream.erb).
      Always rendered — even when empty — so the first reply has somewhere to land; the
      empty-state placeholder carries its own id and is removed by that same stream. %>
  <div id="<%= dom_id(hujah, :responses) %>" class="mt-3 flex flex-col">
    <% if children.any? %>
      <% children.each do |child| %>
        <%= render "hujahs/child_card", child: child, hujah: hujah, live_debate_keys: live_debate_keys, reply_count: reply_counts[child.id].to_i %>
      <% end %>
      <div data-response-filter-target="empty" hidden>
        <%= render "ui/empty_state", message: "No responses match this filter yet", class: "px-1" %>
      </div>
    <% else %>
      <div id="<%= dom_id(hujah, :responses_empty) %>">
        <%= render "ui/empty_state", message: "No responses yet", class: "px-1" %>
      </div>
    <% end %>
  </div>
</div>
