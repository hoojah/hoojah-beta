<%# Faithful port of the legacy SPA `Hujah.jsx` — the single-hujah screen:
    back + more-actions subnav, the full card (parent stub, body, per-stance vote
    rows, counts), then the response-filter section wrapping threaded children.

    DESIGN SYSTEM (Slice 9, Task 4.3) — this is HujahCard.prompt.md's
    `size="detail"`: the same component as a feed card, at 20px (`text-xl`) instead of
    18px, with the share menu and the parent stub shown. Everything it shares with
    `_hujah_card` now comes from the same places — `ui/_card` for the surface,
    `ui/_divider` for the footer hairline (which this screen was missing outright, drift
    rather than a decision), `hujahs/_hujah_header` for the byline.

    The more-actions dropdown is `ui/_menu` + `ds_menu_item_classes`, the second of the
    three call sites those primitives were extracted for in Task 4.1. `w-56` is passed
    explicitly — `ui/_menu` requires a width because a baked default and a caller's
    width are the same Tailwind family and the bundle's order, not the caller's, decides
    which wins. The `<details class="relative">` stays here: the primitive is the panel
    only, and `absolute` needs this element to position against. %>
<% total_votes = @hujah.total_votes %>

<%= render "shared/navbar" %>

<% trending_ids = Rails.cache.read("trending:v1") %>
<% first_tag = @hujah.hashtags.first %>
<% header_label = (trending_ids&.include?(@hujah.id) && first_tag) ? "Trending in ##{first_tag.display} · #{total_votes} #{"vote".pluralize(total_votes)}" : "Hoojah" %>

<main class="max-w-xl mx-auto px-4 py-6">
  <%# Hoojah 2026 contextual header (mockup lines ~1-30): back · centre context label ·
      share + more-actions. The share menu and the more/flag menu are the SAME primitives
      as before (share_spec / flag_spec click them by aria-label) — only their placement
      moved out of `_hujah_header` (which is still the feed byline and must not change)
      into this header. %>
  <header class="flex items-center justify-between gap-2 mb-3">
    <%= link_to root_path, class: "text-ink no-underline shrink-0", aria: { label: "Back" } do %>
      <%= lucide_icon("arrow-left", class: "w-6 h-6") %>
    <% end %>
    <span class="flex-1 min-w-0 truncate text-center text-sm font-bold text-ink"><%= header_label %></span>
    <div class="flex items-center gap-1 shrink-0">
      <%= render "hujahs/share_menu", hujah: @hujah %>
      <details class="relative">
        <summary class="list-none cursor-pointer text-ink" aria-label="More actions">
          <%= lucide_icon("more-horizontal", class: "w-6 h-6") %>
        </summary>
        <%= render layout: "ui/menu", locals: {width: "w-56"} do %>
          <% if user_signed_in? && @hujah.user_id == current_user.id %>
            <%# Slice 1: edit is offered only while the body is editable (owner-only is
                already established by the enclosing branch; body_editable? adds the
                15-min window + no-conviction gate). Links to the composer in edit mode. %>
            <% if @hujah.body_editable? %>
              <%= link_to "Edit hoojah", edit_hujah_path(@hujah.slug), class: ds_menu_item_classes %>
            <% end %>
            <%# `tone: "neutral"` is DropdownMenu.prompt.md's destructive row (neutral is
                orange under the Spectrum palette — the same tone the report rows use; a
                menu row has no dedicated danger tone). A real DELETE now — `button_to` carries the
                CSRF token; `form: {class: "contents"}` collapses the wrapping <form> so the
                button sits as a normal row in the menu's vertical stack instead of adding a
                block box. `data-turbo-confirm` goes on the FORM (turbo-rails reads it there,
                per the moderation "Remove" button) → native confirm, no custom dialog. The
                controller refuses when the hoojah has replies or a debate.
                Issue #38: capture where the viewer came from BEFORE opening this hoojah
                (`request.referer`) NOW — at destroy time the referer is this show page
                itself. `safe_return_path` returns a validated same-origin path (or nil),
                and `button_to`'s `params:` renders it as a hidden `return_to` input the
                controller re-validates. Only pass it when present, so the hidden input is
                absent (→ feed fallback) rather than empty when there's no safe origin. %>
            <% return_to = safe_return_path(request.referer, hujah_path(@hujah.slug)) %>
            <%= button_to "Delete hoojah", hujah_path(@hujah.slug),
                  method: :delete,
                  class: ds_menu_item_classes(tone: "neutral"),
                  params: (return_to ? {return_to: return_to} : {}),
                  form: {class: "contents", data: {turbo_confirm: "Delete this hoojah? This can't be undone."}} %>
          <% end %>
          <% if user_signed_in? %>
            <%= render "hujahs/flag_dialog", hujah: @hujah %>
          <% else %>
            <%# `tone: "neutral"` is DropdownMenu.prompt.md's rule that report rows take
                pink. `flex items-center gap-1` overrides the helper's baked `block` — that
                works because the bundle emits `.block` before `.flex`, which is bundle
                order rather than call order, so it is the ONE override to make here and
                never a second padding or width. %>
            <%= link_to new_user_session_path,
                  class: "#{ds_menu_item_classes(tone: "neutral")} flex items-center gap-1" do %>
              <%= lucide_icon("flag", class: "w-4 h-4") %> Login to flag this hoojah
            <% end %>
          <% end %>
        <% end %>
      </details>
    </div>
  </header>

  <%# Author + claim hero (mockup lines ~9-30). NEW markup — deliberately NOT
      `_hujah_header` (that renders on every feed card and must stay put). The verified
      tick is OMITTED (no User#verified?). The Follow control is deferred: `_follow_button`
      is locked to the indigo profile surface (white-on-primary) and would read invisible
      here — flagged in HANDOVER. %>
  <section class="mb-1">
    <div class="flex items-center gap-3">
      <%= render layout: "ui/user_link", locals: {user: @hujah.user, class: "shrink-0"} do %>
        <%= render "ui/avatar", user: @hujah.user, size: :md %>
      <% end %>
      <div class="flex-1 min-w-0 leading-tight">
        <%= render layout: "ui/user_link", locals: {user: @hujah.user, class: "block font-bold text-ink truncate"} do %><%= @hujah.user.full_name %><% end %>
        <div class="text-xs text-ink-2">
          @<%= @hujah.user.username %>
          <span class="mx-1">·</span>
          <time datetime="<%= @hujah.created_at.iso8601 %>" data-local="time-ago"><%= @hujah.created_at.strftime("%b %-d") %></time>
          <% if @hujah.body_edited? %><span class="mx-1">·</span><span class="text-faint">edited</span><% end %>
        </div>
      </div>
    </div>

    <h1 class="hujah-body mt-4 text-2xl font-semibold leading-snug tracking-tight text-ink"><%= format_body(@hujah.body) %></h1>

    <% if @hujah.hashtags.any? %>
      <div class="mt-3 flex gap-2 flex-wrap">
        <% @hujah.hashtags.each_with_index do |tag, i| %>
          <%= link_to "##{tag.display}", tag_path(tag.name),
                class: "text-xs font-semibold px-3 py-1.5 rounded-full no-underline #{i.zero? ? "bg-primary-soft text-primary" : "bg-card-2 text-ink-2"}" %>
        <% end %>
      </div>
    <% end %>
  </section>

  <%= render "hujahs/vote_hero",
        hujah: @hujah,
        current_user_vote: @hujah.current_user_vote(logged_in: user_signed_in?, current_user_id: current_user&.id),
        current_vote_locked: (user_signed_in? && @hujah.votes.find_by(user_id: current_user.id)&.conviction) || false %>

  <%# Hoojah 2026 argument composer — replaces the old "Add hoojah" link. Locked until
      the viewer votes (mirrors HujahPolicy#create?), then a real POST /hoojah reply form.
      respond_hujah_path stays reachable inside it as the JS-off fallback. Only shown to a
      signed-in viewer who is not the author (an author replying to their own claim is not
      a use case here). %>
  <% if user_signed_in? && current_user.id != @hujah.user_id %>
    <%= render "hujahs/argument_composer", hujah: @hujah, voted: @hujah.voted_by?(current_user) %>
  <% end %>

  <%# Debates lens (Slice 4). Lists the debates on this hoojah visible to the viewer
      (policy_scope in HujahsController#show — concluded to everyone, plus the viewer's
      own live ones). The container dom_id is the Turbo-Stream append target when a new
      challenge is created, so it must always be present. %>
  <% debates_list = @debates.to_a %>
  <section class="mt-6 mb-2">
    <div class="flex items-center justify-between mb-2 px-1">
      <h2 class="flex items-center gap-1.5 text-sm font-extrabold text-ink">
        <%= lucide_icon("swords", class: "w-4 h-4 text-ink-2") %> Debates
      </h2>
      <% if debates_list.any? %>
        <span class="text-xs text-faint font-semibold">
          <%= debates_list.count(&:active?) %> live · <%= debates_list.count(&:concluded?) %> concluded
        </span>
      <% end %>
    </div>
    <div id="<%= dom_id(@hujah, :debates) %>" class="flex flex-col gap-2">
      <%= render partial: "debates/debate_card", collection: @debates, as: :debate %>
    </div>
    <% if @debates.none? %>
      <%# The house empty state — this screen is one of the six call sites `ui/_empty_state`
          was extracted for. It gains a `bg-white` surface (EmptyState.jsx's
          `--surface-card`; the partial's header calls that a correction, not a
          regression) and the section's own `swords` glyph. `class: "px-1"` overrides the
          baked `p-3` on the x axis ONLY — Tailwind emits the shorthand before the
          longhands, so the longhand wins — keeping this row flush with the heading above
          it while the vertical padding the surface now needs survives. %>
      <%= render "ui/empty_state",
            message: "No debates yet — challenge a response to start one.",
            icon: "swords", class: "px-1" %>
    <% end %>
  </section>

  <%= render "hujahs/response_filter", hujah: @hujah, children: @children %>
</main>
