<%# Faithful port of the legacy SPA `Hujah.jsx` — the single-hujah screen:
    back + more-actions subnav, the full card (parent stub, body, per-stance vote
    rows, counts), then the response-filter section wrapping threaded children. %>
<% total_votes = @hujah.agree_count.to_i + @hujah.neutral_count.to_i + @hujah.disagree_count.to_i %>

<%= render "shared/navbar" %>

<main class="max-w-xl mx-auto px-4 py-6">
  <nav class="flex justify-between items-center mb-2">
    <%= link_to root_path, class: "fill-primary text-primary no-underline", aria: { label: "Back" } do %>
      <%= lucide_icon("arrow-left", class: "w-6 h-6") %>
    <% end %>
    <details class="relative">
      <summary class="list-none cursor-pointer fill-primary text-primary" aria-label="More actions">
        <%= lucide_icon("more-horizontal", class: "w-6 h-6") %>
      </summary>
      <div class="absolute right-0 mt-1 w-56 bg-white shadow rounded p-2 z-10">
        <% if user_signed_in? && @hujah.user_id == current_user.id %>
          <span class="block px-3 py-1 text-grey">Delete hoojah (Slice 2)</span>
        <% end %>
        <% if user_signed_in? %>
          <%= render "hujahs/flag_dialog", hujah: @hujah %>
        <% else %>
          <%= link_to new_user_session_path, class: "flex items-center gap-1 px-3 py-1 text-neutral fill-neutral no-underline" do %>
            <%= lucide_icon("flag", class: "w-4 h-4") %> Login to flag this hoojah
          <% end %>
        <% end %>
      </div>
    </details>
  </nav>

  <article class="shadow bg-white mb-2">
    <%= render "hujahs/hujah_header", hujah: @hujah, parent: @hujah.parent %>

    <div class="px-4 pt-3 pb-1 text-black">
      <h3 class="hujah-body text-xl leading-snug"><%= format_body(@hujah.body) %></h3>
    </div>

    <%= render "hujahs/vote_bars",
          hujah: @hujah,
          current_user_vote: @hujah.current_user_vote(logged_in: user_signed_in?, current_user_id: current_user&.id) %>

    <div class="px-4 py-2 flex items-center text-sm text-grey fill-grey">
      <%= lucide_icon("bar-chart-2", class: "w-4 h-4") %>
      <span class="ml-1"><%= total_votes %></span>
      <span class="mx-2">·</span>
      <%= lucide_icon("message-circle", class: "w-4 h-4") %>
      <span class="ml-1"><%= @children.size %></span>
    </div>
  </article>

  <%# Port of the legacy SPA `Layouts/button_add_hujah.js` — the respond entry.
      Seeds the compose form with this hoojah as the parent (stance-tagged reply). %>
  <% stance = @hujah.current_user_vote(logged_in: user_signed_in?, current_user_id: current_user&.id) || "primary" %>
  <div class="flex justify-center mb-2">
    <%= link_to respond_hujah_path(@hujah.slug),
          class: "shadow inline-flex items-center gap-1 rounded-full px-5 py-2 border-2 no-underline border-#{stance} text-#{stance} fill-#{stance}" do %>
      <%= lucide_icon("message-square-plus", class: "w-4 h-4") %> Add hoojah
    <% end %>
  </div>

  <%= render "hujahs/response_filter", hujah: @hujah, children: @children %>
</main>
