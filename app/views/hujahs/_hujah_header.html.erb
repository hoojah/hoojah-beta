<%# Faithful port of the legacy SPA `Hujah/card_header.js`: avatar + full_name + @handle,
    plus a share menu (native <details>, no JS needed). Optional `parent:` local
    renders the "Response to ..." parent stub (port of card_parent.js). %>
<% if local_assigns[:parent].present? %>
  <%= link_to hujah_path(parent.slug), class: "block no-underline" do %>
    <div class="shadow-sm border-b border-light-grey px-4 py-1 flex items-center">
      <%= image_tag parent.user.photo, class: "rounded-full w-8 h-8 mr-2", alt: parent.user.username %>
      <div class="flex flex-col min-w-0">
        <small class="text-grey">
          Response to <span class="text-primary"><%= parent.user.full_name %></span>'s hoojah
        </small>
        <div class="text-grey text-sm truncate max-w-[350px]"><%= strip_tags(parent.body) %></div>
      </div>
    </div>
  <% end %>
<% end %>

<div class="px-4 pt-3 pb-0 flex justify-between items-center">
  <div class="flex items-center min-w-0">
    <%= link_to "#", class: "shrink-0" do %>
      <%= image_tag hujah.user.photo, class: "rounded-full w-11 h-11 mr-3", alt: hujah.user.username %>
    <% end %>
    <div class="flex flex-col min-w-0">
      <%= link_to hujah.user.full_name, "#", class: "text-primary font-medium no-underline truncate" %>
      <small class="text-grey">
        @<%= hujah.user.username %>
        <span class="mx-1">·</span>
        <time datetime="<%= hujah.created_at.iso8601 %>" data-local="time-ago"><%= hujah.created_at.strftime("%b %-d") %></time>
      </small>
    </div>
  </div>

  <%= render "hujahs/share_menu", hujah: hujah %>
</div>
