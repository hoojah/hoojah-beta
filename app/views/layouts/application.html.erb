<!DOCTYPE html>
<%# Server default: light + spectrum, so the page is fully themed with JS off.
    <html> is NOT replaced by Turbo, so the no-FOUC script's overrides (and the
    theme_controller's) persist across Turbo visits. %>
<html data-theme="light" data-scheme="spectrum">
  <head>
    <title>Hoojah</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# No-FOUC: re-apply the persisted theme/scheme BEFORE the stylesheet paints,
        so a dark-mode user never flashes light on first load. Reads localStorage
        only and sets attributes — it contains NO Tailwind utility strings, so the
        source scanner can't mint stray rules from it. Nonce'd for the CSP (same
        mechanism the Drift snippet uses); no 'unsafe-inline'. %>
    <script nonce="<%= content_security_policy_nonce %>">
      (function () {
        try {
          var t = localStorage.getItem("hoojah-theme");
          var s = localStorage.getItem("hoojah-scheme");
          var el = document.documentElement;
          if (t === "light" || t === "dark") el.setAttribute("data-theme", t);
          if (s === "spectrum" || s === "signal" || s === "ballot") el.setAttribute("data-scheme", s);
        } catch (e) {}
      })();
    </script>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <%= render "layouts/flash" %>
    <%= yield %>
    <%# Third-party widgets (Cloudinary upload + Drift live chat). Skipped in test:
        headless Chrome would hang on these external hosts, surfacing as intermittent
        Ferrum::PendingConnectionsError. None of the specs exercise the remote widgets
        (Cloudinary wiring is asserted structurally), so leaving them out makes the
        system suite deterministic without changing dev/production behaviour. %>
    <% unless Rails.env.test? %>
    <script src="//widget.cloudinary.com/global/all.js" type="text/javascript"></script>
    <%# Drift live chat (appId fx42y6ieyaff) — inline, allowed by a CSP nonce (no 'unsafe-inline'). %>
    <script nonce="<%= content_security_policy_nonce %>">
      "use strict";
      !function() {
        var t = window.driftt = window.drift = window.driftt || [];
        if (!t.init) {
          if (t.invoked) return void (window.console && console.error && console.error("Drift snippet included twice."));
          t.invoked = !0, t.methods = [ "identify", "config", "track", "reset", "debug", "show", "ping", "page", "hide", "off", "on" ],
          t.factory = function(e) {
            return function() {
              var n = Array.prototype.slice.call(arguments);
              return n.unshift(e), t.push(n), t;
            };
          }, t.methods.forEach(function(e) {
            t[e] = t.factory(e);
          }), t.load = function(t) {
            var e = 3e5, n = Math.ceil(new Date() / e) * e, o = document.createElement("script");
            o.type = "text/javascript", o.async = !0, o.crossorigin = "anonymous", o.src = "https://js.driftt.com/include/" + n + "/" + t + ".js";
            var i = document.getElementsByTagName("script")[0];
            i.parentNode.insertBefore(o, i);
          };
        }
      }();
      drift.SNIPPET_VERSION = '0.3.1';
      drift.load('fx42y6ieyaff');
    </script>
    <% end %>
  </body>
</html>
